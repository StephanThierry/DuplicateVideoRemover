@page "/scan"
@implements IDisposable
@inject AppController App
@inject NavigationManager Nav

<PageTitle>Scan</PageTitle>

<div class="page">
    <div class="page-head">
        <div>
            <h1>Scan</h1>
            <p>Finds the videos in your folders, reads the new ones and compares them all.</p>
        </div>
        @* The final report arrives just before the engine clears IsRunning: a finished scan is not running *@
        @if (App.Scanner.IsRunning && p.Phase is not (ScanPhase.Done or ScanPhase.Cancelled or ScanPhase.Failed))
        {
            <button class="big" @onclick="Stop" disabled="@stopping">@(stopping ? "Stopping..." : "Stop scan")</button>
        }
        else
        {
            <div class="inline">
                @if (LastScan.FoundUtc is DateTime listed)
                {
                    @* The saved file list: All files opens it straight away, nothing is scanned *@
                    <button class="big" @onclick='() => Nav.NavigateTo("files")' title="Opens the files the last scan found - nothing is scanned">Show all files from @Fmt.When(listed)</button>
                }
                @if (p.Phase == ScanPhase.Idle)
                {
                    <button class="primary big" @onclick="Start" disabled="@(App.Settings.contentFolders.Length == 0)">Start scan</button>
                }
                else
                {
                    @* After a scan (finished, stopped or failed): run it again *@
                    <button class="primary big" @onclick="Start" disabled="@(App.Settings.contentFolders.Length == 0)">
                        Run new scan
                        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-3px;margin-left:6px"><path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z" fill="currentColor" /></svg>
                    </button>
                }
            </div>
        }
    </div>

    <div class="scan-grid">
        <section class="panel" aria-live="polite">
            @if (p.Phase == ScanPhase.Idle)
            {
                <p class="muted">No scan running. A scan has two parts: A) finding all video files in your folders, B) reading the new ones and comparing. Videos already in the database are not read again, so later scans are much faster.</p>
            }
            else
            {
                @PhaseBlock("A", "Finding files", ScanText.FindState(p), p.FindFraction, ScanText.FindUnknownTotal(p), ScanText.FindDetail(p), ScanText.FindLeft(p))
                @PhaseBlock("B", "Processing", ScanText.ProcessState(p), p.ProcessFraction, false, ScanText.ProcessDetail(p), ScanText.ProcessLeft(p))

                <dl class="stats">
                    <div><dt>Videos found</dt><dd>@p.FilesFound.ToString("N0")</dd></div>
                    @if (p.Phase >= ScanPhase.ReadingVideos)
                    {
                        <div><dt>Already read before</dt><dd>@Math.Max(p.FilesFound - p.NewTotal, 0).ToString("N0")</dd></div>
                        <div><dt>New videos read</dt><dd>@p.NewDone.ToString("N0") of @p.NewTotal.ToString("N0")</dd></div>
                        <div><dt>Could not read @if (p.FailedFiles.Count > 0) { <button class="info-icon" @onclick="() => showFailed = true" title="Show the files that could not be read, and why" aria-label="Show the files that could not be read">i</button> }</dt><dd>@p.Failed.ToString("N0")</dd></div>
                    }
                    <div><dt>Time so far</dt><dd>@Fmt.Time(p.Elapsed)</dd></div>
                    @if (p.SecondsPerNewFile is double s)
                    {
                        <div><dt>Per new video</dt><dd>@s.ToString("0.0") s</dd></div>
                    }
                </dl>

                @if (p.Phase == ScanPhase.ReadingVideos && !string.IsNullOrEmpty(p.CurrentFile))
                {
                    <div class="nowreading">Reading @p.CurrentFile</div>
                }

                @if (recent.Count > 0)
                {
                    <h3 class="minihead">Scan status</h3>
                    <p class="muted small" style="margin:2px 0 6px">White frame: a new or changed video, being read now. No frame: known from an earlier scan.</p>
                    <div class="recent" style="margin-top:0" aria-label="Pictures of the latest videos read">
                        @foreach (var v in recent)
                        {
                            <button type="button" class="@ThumbClass(v)" @onclick="() => playing = v" title="@ThumbTitle(v)" aria-label="Play @v.FileName">
                                <img src="shots/@(v.Id)_2.png" alt="" onerror="this.style.display='none'" />
                                <span class="playbadge" aria-hidden="true"><svg width="10" height="11" viewBox="0 0 10 11"><path d="M0 0v11l10-5.5z" fill="currentColor" /></svg></span>
                            </button>
                        }
                    </div>
                }

                @if (p.Phase == ScanPhase.Done)
                {
                    <div class="notice">
                        <p><strong>@p.Message.</strong></p>
                        <p style="margin-top:10px">
                            <button class="primary" @onclick='() => Nav.NavigateTo("")'>Review results</button>
                            <button @onclick='() => Nav.NavigateTo("encode")'>Re-encode large videos</button>
                        </p>
                        <p class="muted" style="margin-top:8px">Delete duplicates first, then re-encode: deleted videos are left out of the re-encode list.</p>
                    </div>
                }
                else if (p.Phase == ScanPhase.Cancelled)
                {
                    <div class="notice warn"><p>@p.Message</p></div>
                }
                else if (p.Phase == ScanPhase.Failed)
                {
                    <div class="notice warn"><p><strong>The scan stopped with an error:</strong> @p.Message</p></div>
                }
            }
        </section>

        <aside>
            <section class="panel scope">
                <h2>What is scanned</h2>
                @if (App.Settings.contentFolders.Length == 0)
                {
                    <p class="muted">No folders yet. Add the folders with your videos in Settings.</p>
                }
                else
                {
                    <ul class="tags" aria-label="Folders to scan">@foreach (var f in App.Settings.contentFolders) { <li title="@f">@f</li> }</ul>
                }
                @if (App.Settings.excludePaths.Length > 0)
                {
                    <p class="muted">There @(App.Settings.excludePaths.Length == 1 ? "is" : "are") @Fmt.Plural(App.Settings.excludePaths.Length, "active path filtering rule", "active path filtering rules").</p>
                }
                <p style="margin-top:12px"><button @onclick='() => Nav.NavigateTo("settings#folders")'>Change folders and rules</button></p>
            </section>
            <section class="panel">
                <h2>Last scan</h2>
                @if (last == null)
                {
                    <p class="muted">These folders have not been scanned yet. The first scan reads every video and takes the longest.</p>
                }
                else
                {
                    <p>@Fmt.Ago(last.StartedUtc), @(last.Completed ? "finished" : "stopped") after @Fmt.Approx(TimeSpan.FromSeconds(last.TotalSeconds)).</p>
                    <p class="muted" style="margin-top:6px">@last.FilesInScope.ToString("N0") videos, @last.NewFiles.ToString("N0") of them read for the first time.</p>
                }
            </section>
        </aside>
    </div>
</div>

<VideoPlayer Video="playing" OnClose="() => playing = null" />

@if (showFailed && p.FailedFiles.Count > 0)
{
    <div class="dialog-backdrop" @onclick="() => showFailed = false">
        <div class="dialog wide" role="dialog" aria-modal="true" aria-labelledby="failed-title" @onclick:stopPropagation="true">
            <h2 id="failed-title">@Fmt.Plural(p.FailedFiles.Count, "video could not be read", "videos could not be read")</h2>
            <p>These are left out of the comparison. Try opening one in a video player: a file that is still being copied or downloaded is read again by the next scan.</p>
            <div class="hidden-list">
                @foreach (var f in p.FailedFiles)
                {
                    <div class="hidden-row failed-row">
                        <div><strong>@f.FileName</strong><div class="muted small">@f.Folder</div></div>
                        <div>@f.Reason</div>
                    </div>
                }
            </div>
            <div class="buttons"><button class="primary" @onclick="() => showFailed = false">Close</button></div>
        </div>
    </div>
}

@code {
    private bool showFailed;
    private ScanProgress p = new();
    private readonly List<VideoEntry> recent = new();
    private VideoEntry? playing;
    private RunRecord? last;
    private bool stopping;

    // One phase: name, its own bar (striped while the total isn't known) and what it is doing
    private RenderFragment PhaseBlock(string letter, string name, PhaseState state, double fraction, bool unknownTotal, string detail, string left) =>
        @<div class="phase @state.ToString().ToLowerInvariant()">
            <div class="phase-head">
                <span class="phase-name"><span class="phase-letter">@letter</span> @name</span>
                <span class="phase-pct num">@(state == PhaseState.Waiting || unknownTotal ? "" : ScanText.Percent(fraction) + "%")</span>
            </div>
            <div class="bar @(state == PhaseState.Done ? "done" : "") @(unknownTotal ? "unknown" : "")" role="progressbar" aria-label="@name"
                 aria-valuemin="0" aria-valuemax="100" aria-valuenow="@(unknownTotal ? (int?)null : ScanText.Percent(fraction))">
                <div style="width:@((unknownTotal ? 100 : fraction * 100).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%"></div>
            </div>
            <div class="phase-detail"><span>@detail</span><span class="muted">@left</span></div>
        </div>;

    protected override void OnInitialized()
    {
        p = App.Scanner.Current;
        last = App.LastRun();
        App.Scanner.ProgressChanged += OnProgress;
    }

    private static string ThumbClass(VideoEntry v) => v.IsNew ? "thumbbtn isnew" : "thumbbtn";
    private static string ThumbTitle(VideoEntry v) => (v.IsNew ? "New file: " : "") + v.FileName;

    private void OnProgress(ScanProgress progress)
    {
        p = progress;
        if (progress.LastVideo is { } shown && recent.FirstOrDefault(r => r.Id == shown.Id) is { } same && shown.IsNew && !same.IsNew)
            recent[recent.IndexOf(same)] = shown;   // it was shown as a known file, and turned out to be a new one
        else if (progress.LastVideo is { } shown2 && !recent.Any(r => r.Id == shown2.Id))
        {
            recent.Insert(0, shown2);
            if (recent.Count > 8) recent.RemoveAt(recent.Count - 1);
        }
        if (progress.Phase is ScanPhase.Done or ScanPhase.Cancelled or ScanPhase.Failed)
        {
            stopping = false;
            last = App.LastRun();
        }
        InvokeAsync(StateHasChanged);
    }

    private void Start()
    {
        recent.Clear();
        App.StartScan();
    }

    private void Stop()
    {
        stopping = true;
        App.Scanner.Cancel();
    }


    public void Dispose() => App.Scanner.ProgressChanged -= OnProgress;
}
