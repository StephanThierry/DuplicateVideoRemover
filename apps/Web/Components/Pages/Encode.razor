@page "/encode"
@implements IDisposable
@inject AppController App
@inject NavigationManager Nav

<PageTitle>Re-encode planning</PageTitle>

<div class="page">
    <div class="page-head">
        <div>
            <h1>Re-encode planning</h1>
            <p>Videos with the highest bitrate first - they usually shrink the most. Click a video to pick it, Shift-click to pick everything in between, then add them to the encode queue (or create a script).</p>
        </div>
    </div>

    <div class="panel" style="margin-bottom:16px">
        <div class="enc-summary">
            <strong>@EncodeOptions.Codec(enc.codec).Label, @(enc.resolution)p, quality @enc.crf</strong>
            <span class="muted">@EncodeOptions.QualityLabel(enc.codec, enc.crf ?? 0)</span>
            <span class="muted">Speed: @enc.preset, @(enc.audio == "copy" ? "original sound" : "AAC sound"), @enc.container.ToUpperInvariant()</span>
            <button class="link" @onclick='() => Nav.NavigateTo("settings#encoding")'>Change in Settings</button>
        </div>
        @* What is in the encode queue right now *@
        @if (queueMap.Count > 0)
        {
            <div class="enc-summary" style="margin-top:8px">
                <span>@QueueSummary()</span>
                <button class="link" @onclick='() => Nav.NavigateTo("encoding")'>Open Re-encode queue</button>
            </div>
        }
    </div>

    @if (scriptPath != null)
    {
        <div class="result" role="status">
            <p><strong>Created a script for @Fmt.Plural(scriptCount, "video", "videos").</strong></p>
            <p style="margin-top:6px">Saved as <code>@scriptPath</code>. <a href="output/@System.IO.Path.GetFileName(scriptPath)" download>Download it</a></p>
            <p class="muted" style="margin-top:6px">Run it on the computer with the videos:
                <code>@(ScriptFile.IsWindows ? $"powershell -ExecutionPolicy Bypass -File \"{scriptPath}\"" : $"sh \"{scriptPath}\"")</code>.
                The new files are saved next to the originals, which are not changed.</p>
        </div>
    }

    @if (candidates == null)
    {
        <div class="empty" role="status">
            <h2>Loading your videos...</h2>
            <div class="bar unknown" role="progressbar" aria-label="Loading" style="max-width:460px;margin:0 auto"><div style="width:100%"></div></div>
            <p>Reading the videos from the last scan and checking which can be re-encoded. This takes a few seconds - no new scan is needed.</p>
        </div>
    }
    else if (candidates.Count == 0)
    {
        <div class="empty">
            <h2>No videos to re-encode</h2>
            <p>Scan your folders first. Duplicates, broken videos and left-out file types are not listed.</p>
            <button class="primary big" @onclick='() => Nav.NavigateTo("scan")'>Go to scan</button>
        </div>
    }
    else
    {
        <div class="toolbar">
            <label class="sortpick">Search
                <input type="search" class="files-search" placeholder='e.g. vacation lisbon 2026 -ocean' title='All words must be in the path, -word leaves out paths with that word, "two words" searches that exact phrase in that order; inside the quotes a regular expression works, e.g. "night.?drive".' @bind="search" @bind:event="oninput" @bind:after="ResetPaging" aria-label="Search in the file paths" />
            </label>
        </div>
        <div class="toolbar">
            <button @onclick="SelectVisible">Select all</button>
            <button @onclick="() => SelectTop(20)">Select top 20</button>
            <button @onclick="() => picked.Clear()" disabled="@(picked.Count == 0)">Select none</button>
            <button @onclick="() => managingHidden = true" title="See the folders that are hidden here, show them again one by one, or hide a folder (with everything below it)">Manage hidden folders@(hidden.Count > 0 ? $" ({hidden.Count})" : "")</button>
            @if (queueMap.Count > 0)
            {
                <label class="inline"><input type="checkbox" checked="@hideQueued" @onchange="e => { hideQueued = (bool)e.Value!; ResetPaging(); }" /> Hide videos in the queue</label>
            }
            <label class="inline">Only above <input type="number" min="0" step="500" @bind="minKbps" @bind:after="ResetPaging" aria-label="Minimum bitrate" /> kbit/s</label>
            <label class="inline">and above <input type="number" min="0" step="50" @bind="minMb" @bind:after="ResetPaging" aria-label="Minimum file size in MB" /> MB</label>
            <label class="sortpick">Sort by
                <select @bind="sort" @bind:after="ResetPaging" aria-label="Sort the videos by">
                    @foreach (var (label, value) in FileSorting.Choices)
                    {
                        <option value="@value">@label</option>
                    }
                </select>
            </label>
        </div>

        var visible = Visible().ToList();
        <p class="muted" style="font-size:.85rem;margin:0 0 8px">Estimated sizes are rough: the real result depends on each video's resolution and content.</p>
        <div class="enc-list">
            <div class="enc-row head"><span></span><span></span><span></span><span>Video</span><span class="num">Bitrate</span><span class="num">Size now</span><span class="num">Estimated after</span></div>
            @foreach (var c in visible.Take(shown))
            {
                bool on = picked.Contains(c.Id);
                bool queued = queueMap.TryGetValue(c.Path, out var queueState);
                long est = EncodeEstimator.EstimatedBytes(c, enc, targetKbps);
                <div class="enc-row @(on ? "is-picked" : "") @(queued ? "is-queued" : "")" @key="c.Id" @onclick="e => RowClick(c.Id, e)" role="checkbox" aria-checked="@(on ? "true" : "false")" aria-disabled="@(queued ? "true" : null)" tabindex="0"
                     @onkeydown="e => RowKey(c.Id, e)" aria-label="@c.FileName">
                    <input type="checkbox" checked="@on" disabled="@queued" tabindex="-1" aria-hidden="true" />
                    <div class="enc-strip">
                        @for (int i = 1; i <= 3; i++) { <img loading="lazy" src="shots/@(c.Id)_@(i).png" alt="" onerror="this.style.visibility='hidden'" /> }
                    </div>
                    <button class="icon" @onclick="() => playing = ToEntry(c)" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" title="Play" aria-label="Play @c.FileName">@VideoPlayer.Icon</button>
                    <div class="info">
                        <div class="name">@c.FileName</div><div class="muted" style="font-size:.85rem;word-break:break-all">@c.Folder</div><div class="muted" style="font-size:.85rem">@Fmt.Duration(c.DurationSeconds)</div>
                        @if (queued) { <div class="q-tag">@QueueLabel(queueState)</div> }
                        <div class="enc-actions" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                            <button class="small" @onclick="() => HideFolder(c.Folder)" title="Hide every video in @c.Folder">Exclude folder</button>
                            <button class="small" @onclick="() => CopyPath(c)" title="Copy the full path">Copy path</button>
                            <button class="small danger-outline" @onclick="() => deleting = c" title="Delete this file">Delete</button>
                        </div>
                    </div>
                    <span class="num">@c.AverageKbps.ToString("N0") kbit/s</span>
                    <span class="num">@Fmt.Size(c.SizeBytes)</span>
                    <span class="num">@Fmt.Size(est)<br /><small class="@(c.SizeBytes - est > c.SizeBytes / 10 ? "saving" : "muted")">@SavingText(c.SizeBytes, est)</small></span>
                </div>
            }
        </div>
        @if (visible.Count > shown)
        {
            <div class="more"><button @onclick="() => shown += 100">Show @Math.Min(100, visible.Count - shown) more</button></div>
        }

        <div class="actionbar">
            <div class="inner">
                <div class="count num">
                    @Fmt.Plural(picked.Count, "video", "videos") picked
                    <small>@Fmt.Size(PickedBytes) now, about @Fmt.Size(PickedEstimate) after. Saves about @Fmt.Size(PickedBytes - PickedEstimate)@PercentText(PickedBytes, PickedEstimate)</small>
                </div>
                @* Per batch: encode here in the queue, or create a script (the default is set in Settings) *@
                <select style="margin-left:auto" @bind="runMode" aria-label="What to do with the picked videos">
                    @foreach (var m in EncodeOptions.RunModes) { <option value="@m.Id">@m.Label</option> }
                </select>
                <button class="primary big" disabled="@(picked.Count == 0)" @onclick="Primary">@(runMode == "run" ? "Add to queue" : "Create encoding script")</button>
            </div>
        </div>
    }
</div>

@if (confirming)
{
    <div class="dialog-backdrop" @onclick="() => confirming = false">
        <div class="dialog" role="alertdialog" aria-modal="true" aria-labelledby="enc-confirm" @onclick:stopPropagation="true">
            <h2 id="enc-confirm">Create an encoding script for @Fmt.Plural(picked.Count, "video", "videos")?</h2>
            <p>@EncodeOptions.Codec(enc.codec).Label, @(enc.resolution)p, quality @enc.crf. Now @Fmt.Size(PickedBytes), about @Fmt.Size(PickedEstimate) after, saving about @Fmt.Size(PickedBytes - PickedEstimate). The script makes new files next to the originals; nothing changes until you run it.</p>
            <div class="buttons">
                <button @onclick="() => confirming = false">Cancel</button>
                <button class="primary" @onclick="Create">Create script</button>
            </div>
        </div>
    </div>
}

@if (managingHidden)
{
    <div class="dialog-backdrop" @onclick="() => managingHidden = false">
        <div class="dialog wide" role="dialog" aria-modal="true" aria-labelledby="hidden-title" @onclick:stopPropagation="true">
            <h2 id="hidden-title">Hidden folders</h2>
            <p>Videos in these folders, and in the folders below them, are left out of this list. They stay hidden after a restart. Scans still read them (to skip a folder in scans, use the paths to skip in Settings).</p>
            <form class="hide-add" @onsubmit="AddHidden" @onsubmit:preventDefault="true">
                <label for="hide-folder"><strong>Hide a folder</strong></label>
                <div class="row-inline">
                    <input id="hide-folder" type="text" @bind="newHidden" @bind:event="oninput" placeholder="A folder, e.g. D:\Videos\Archive - the folders below it are hidden too" />
                    <button class="primary" type="submit" disabled="@string.IsNullOrWhiteSpace(newHidden)">Hide</button>
                </div>
            </form>
            <div class="hidden-list">
                @if (hidden.Count == 0) { <div class="muted empty">No folders are hidden.</div> }
                @foreach (var f in hidden.List)
                {
                    int n = (candidates ?? new()).Count(c => HiddenFolders.Covers(f, c.Folder));
                    <div class="hidden-row">
                        <div><strong>@f</strong><div class="muted small">@(n == 0 ? "no videos in the list" : Fmt.Plural(n, "video", "videos") + " hidden")</div></div>
                        <button class="small" @onclick="() => Unhide(f)" title="Show the videos in @f again">Unhide</button>
                    </div>
                }
            </div>
            <div class="buttons spread">
                <button @onclick="UnhideAll" disabled="@(hidden.Count == 0)">Unhide all folders</button>
                <button class="primary" @onclick="() => managingHidden = false">Done</button>
            </div>
        </div>
    </div>
}

@if (deleting != null)
{
    <div class="dialog-backdrop" @onclick="() => deleting = null">
        <div class="dialog" role="alertdialog" aria-modal="true" aria-labelledby="del-confirm" @onclick:stopPropagation="true">
            <h2 id="del-confirm">Delete this video permanently?</h2>
            <p><strong>@deleting.FileName</strong><br />@deleting.Folder<br />@Fmt.Size(deleting.SizeBytes) will be deleted. This can't be undone.</p>
            <div class="buttons">
                <button @onclick="() => deleting = null">Cancel</button>
                <button class="danger" @onclick="DeleteFile">Delete permanently</button>
            </div>
        </div>
    </div>
}

<VideoPlayer Video="playing" OnClose="() => playing = null" />

@if (toast != null)
{
    <div class="toast" role="status">@toast @if (toastQueueLink) { <button class="link" @onclick='() => Nav.NavigateTo("encoding")'>Open Re-encode queue</button> }</div>
}

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;
    // Folders hidden with "Exclude folder" or on the Manage hidden folders screen (kept between runs, shared with the desktop app)
    private HiddenFolders hidden => App.HiddenFolders;
    private bool managingHidden;
    private string newHidden = "";
    private EncodeCandidate? deleting;
    private VideoEntry? playing;

    private static VideoEntry ToEntry(EncodeCandidate c) =>
        new() { Id = c.Id, Path = c.Path, SizeBytes = c.SizeBytes, DurationSeconds = c.DurationSeconds };
    private string? toast;
    private CancellationTokenSource? toastTimer;
    private EncodeSettings enc = EncodeSettings.CreateDefault();
    private List<EncodeCandidate>? candidates;
    private readonly HashSet<int> picked = new();
    private string search = "";
    private FileSort sort = FileSort.BitrateDown;   // highest bitrate first, as before
    private int minKbps;
    private int minMb = 100;
    private int shown = 100;
    private string? scriptPath;
    private int scriptCount;
    private bool confirming;
    private double targetKbps;
    private int? anchorId;          // last clicked video, for Shift-click ranges
    private bool anchorState = true;

    // The encode queue: videos in it are greyed out here (and can be hidden)
    private Dictionary<string, EncodeItemStatus> queueMap = new();
    private bool hideQueued;
    private string queueSig = "";
    private string runMode = EncodeOptions.DefaultRunMode;   // per batch; starts as the saved default
    private string lastDefaultMode = "";
    private bool toastQueueLink;

    protected override async Task OnInitializedAsync()
    {
        App.DataChanged += OnDataChanged;
        App.Encoder.ProgressChanged += OnQueue;
        App.HiddenFolders.Changed += OnHiddenChanged;
        RefreshQueue();
        await Load();
    }

    // Progress ticks change nothing here: only when videos join the queue, start or finish
    private void OnQueue(EncodeProgress p)
    {
        if (QueueSignature(p) == queueSig) return;
        InvokeAsync(() => { RefreshQueue(); StateHasChanged(); });
    }

    private static string QueueSignature(EncodeProgress p) => $"{p.Items.Count}|{p.QueuedCount}|{p.Current?.Id}|{p.DoneCount}|{p.AlreadyEncodedCount}|{p.Items.Count(i => i.OriginalDeleted)}|{p.Items.Count(i => i.NewDeleted)}";

    private void RefreshQueue()
    {
        var p = App.Encoder.Current;
        queueSig = QueueSignature(p);
        queueMap = p.StatusByPath();
        // An original that was deleted (after its new file checked out) is no longer a video to re-encode
        var deleted = p.Items.Where(i => i.OriginalDeleted).Select(i => i.Path).ToHashSet(EncodeProgress.PathComparer);
        if (deleted.Count > 0) candidates?.RemoveAll(c => deleted.Contains(c.Path));
        if (candidates != null) picked.ExceptWith(candidates.Where(c => queueMap.ContainsKey(c.Path)).Select(c => c.Id));
    }

    private string QueueSummary()
    {
        int waiting = queueMap.Values.Count(s => s == EncodeItemStatus.Queued), running = queueMap.Values.Count(s => s == EncodeItemStatus.Running), done = queueMap.Values.Count(s => s == EncodeItemStatus.Done);
        return "Encode queue: " + string.Join(", ", new[] { running > 0 ? "1 encoding" : null, waiting > 0 ? $"{waiting:N0} waiting" : null, done > 0 ? $"{done:N0} done" : null }.Where(x => x != null)) + ".";
    }

    private static string QueueLabel(EncodeItemStatus s) => s switch { EncodeItemStatus.Queued => "In the queue", EncodeItemStatus.Running => "Encoding now", _ => "Encoded" };

    private async Task Load()
    {
        enc = App.Settings.EncodeOrDefault();
        if (enc.runMode != lastDefaultMode) { lastDefaultMode = enc.runMode; runMode = enc.runMode; }
        targetKbps = EncodeEstimator.TargetKbps(enc);
        candidates = await Task.Run(App.EncodeCandidates);
        picked.IntersectWith(candidates.Select(c => c.Id));
        RefreshQueue();
    }

    private void OnDataChanged() => InvokeAsync(async () => { await Load(); StateHasChanged(); });

    private IEnumerable<EncodeCandidate> Visible()
    {
        var query = SearchQuery.Parse(search);
        var shown = (candidates ?? new()).Where(c =>
            !(hideQueued && queueMap.ContainsKey(c.Path)) && c.AverageKbps >= minKbps && c.SizeBytes >= (long)minMb * 1024 * 1024 && !hidden.Hides(c.Folder) &&
            query.Matches(c.Path));
        return FileSorting.Order(shown, sort, c => c.Path, c => c.SizeBytes, c => c.AverageKbps);
    }

    private long PickedBytes => candidates?.Where(c => picked.Contains(c.Id)).Sum(c => c.SizeBytes) ?? 0;

    private long PickedEstimate => candidates?.Where(c => picked.Contains(c.Id)).Sum(c => EncodeEstimator.EstimatedBytes(c, enc, targetKbps)) ?? 0;

    private static string SavingText(long now, long after) =>
        now - after < now / 20 ? "little or no saving" : $"saves {Fmt.Size(now - after)}{PercentText(now, after)}";

    private static string PercentText(long now, long after) => now > 0 ? $" ({(now - after) * 100 / now}%)" : "";

    // Click: pick or unpick one video. Shift-click: give every video between the last click and this one
    // the same state as that last click.
    private void RowClick(int id, MouseEventArgs e)
    {
        var visible = Visible().ToList();
        if (visible.FirstOrDefault(c => c.Id == id) is { } clicked && queueMap.ContainsKey(clicked.Path)) return;   // already in the queue
        if (e.ShiftKey && anchorId is int anchor)
        {
            int a = visible.FindIndex(c => c.Id == anchor), b = visible.FindIndex(c => c.Id == id);
            if (a >= 0 && b >= 0)
            {
                foreach (var c in visible.Skip(Math.Min(a, b)).Take(Math.Abs(a - b) + 1).Where(c => !queueMap.ContainsKey(c.Path)))
                    if (anchorState) picked.Add(c.Id); else picked.Remove(c.Id);
                return;
            }
        }
        anchorState = !picked.Contains(id);
        if (anchorState) picked.Add(id); else picked.Remove(id);
        anchorId = id;
    }

    private void RowKey(int id, KeyboardEventArgs e)
    {
        if (e.Key == " " || e.Key == "Enter") RowClick(id, new MouseEventArgs { ShiftKey = e.ShiftKey });
    }

    private void SelectTop(int n) { foreach (var c in Visible().Where(c => !queueMap.ContainsKey(c.Path)).Take(n)) picked.Add(c.Id); }

    private void SelectVisible() { foreach (var c in Visible().Where(c => !queueMap.ContainsKey(c.Path))) picked.Add(c.Id); }

    private void ResetPaging() => shown = 100;

    // Hidden videos are unpicked too, so the script only holds what can be seen
    private bool HideFolder(string folder)
    {
        if (!hidden.Add(folder)) { ShowToast($"{folder} is hidden already."); return false; }
        int n = 0;
        foreach (var c in (candidates ?? new()).Where(c => HiddenFolders.Covers(folder, c.Folder))) { picked.Remove(c.Id); n++; }
        ResetPaging();
        ShowToast($"Hid {Fmt.Plural(n, "video", "videos")} in {folder} and its subfolders.");
        return true;
    }

    private void AddHidden()
    {
        string folder = newHidden.Trim().Trim('"');
        if (folder.Length > 0 && HideFolder(folder)) newHidden = "";
    }

    private void Unhide(string folder)
    {
        if (hidden.Remove(folder)) { ResetPaging(); ShowToast($"{folder} is shown again."); }
    }

    private void UnhideAll()
    {
        int n = hidden.Count;
        hidden.Clear();
        ResetPaging();
        if (n > 0) ShowToast($"Showing all folders again ({Fmt.Plural(n, "folder was", "folders were")} hidden).");
    }

    // Hidden or shown in another tab or window: show the same here
    private void OnHiddenChanged() => InvokeAsync(StateHasChanged);

    private async Task CopyPath(EncodeCandidate c)
    {
        try
        {
            await JS.InvokeVoidAsync("dvr.copy", c.Path);
            ShowToast("Copied: " + c.Path);
        }
        catch (Exception e) { ShowToast("Could not copy: " + e.Message); }
    }

    private void DeleteFile()
    {
        var c = deleting;
        deleting = null;
        if (c == null) return;
        var error = App.DeleteVideoFile(c.Id, c.Path);
        if (error != null) { ShowToast($"Could not delete {c.FileName}: {error}", 10000); return; }
        candidates?.Remove(c);
        picked.Remove(c.Id);
        ShowToast($"Deleted {c.FileName} ({Fmt.Size(c.SizeBytes)}).");
    }

    private void ShowToast(string text, int ms = 4000, bool queueLink = false)
    {
        toast = text;
        toastQueueLink = queueLink;
        toastTimer?.Cancel();
        toastTimer = new CancellationTokenSource();
        var token = toastTimer.Token;
        _ = Task.Delay(ms, token).ContinueWith(t => { if (t.IsCanceled) return; toast = null; InvokeAsync(StateHasChanged); });
    }

    // The main button: add the picked videos to the encode queue, or ask before creating the script
    private void Primary()
    {
        if (runMode == "run") AddToQueue(); else confirming = true;
    }

    private void AddToQueue()
    {
        // In list order: highest bitrate first
        var videos = (candidates ?? new()).Where(c => picked.Contains(c.Id) && !queueMap.ContainsKey(c.Path)).ToList();
        if (videos.Count == 0) return;
        var result = App.EnqueueEncode(videos);
        // Files that are gone since the scan are not queued and leave the list
        foreach (var gone in result.Missing) { candidates?.RemoveAll(c => c.Id == gone.Id); picked.Remove(gone.Id); }
        picked.Clear();
        RefreshQueue();
        var parts = new List<string> { $"Added {Fmt.Plural(result.Added, "video", "videos")} to the queue." };
        if (result.AlreadyThere > 0) parts.Add($"{Fmt.Plural(result.AlreadyThere, "was", "were")} in it already.");
        if (result.Missing.Count > 0) parts.Add($"{Fmt.Plural(result.Missing.Count, "file was", "files were")} not found any more and left out.");
        if (App.Encoder.Current.Halted && App.Encoder.Current.QueuedCount > 0) parts.Add("The queue is stopped: press Start on the Re-encode queue page.");
        ShowToast(string.Join(" ", parts), result.Missing.Count > 0 ? 10000 : 6000, queueLink: true);
    }

    private void Create()
    {
        confirming = false;
        // In list order: highest bitrate first
        var videos = (candidates ?? new()).Where(c => picked.Contains(c.Id)).ToList();
        var result = App.WriteEncodeScript(videos);
        // Files that are gone since the scan are left out of the script and the list
        foreach (var gone in result.Missing) { candidates?.RemoveAll(c => c.Id == gone.Id); picked.Remove(gone.Id); }
        if (result.Missing.Count > 0)
            ShowToast($"{Fmt.Plural(result.Missing.Count, "file was", "files were")} not found any more and left out.", 10000);
        if (result.Path == null) return;
        scriptPath = result.Path;
        scriptCount = result.Videos;
    }

    public void Dispose()
    {
        App.DataChanged -= OnDataChanged;
        App.Encoder.ProgressChanged -= OnQueue;
        App.HiddenFolders.Changed -= OnHiddenChanged;
        toastTimer?.Cancel();
    }
}
