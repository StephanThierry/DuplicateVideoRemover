@page "/settings"
@implements IDisposable
@inject AppController App

<PageTitle>Settings</PageTitle>

<div class="page">
    <div class="page-head">
        <div>
            <h1>Settings</h1>
            <p>Which folders to scan and how alike two videos must be to count as duplicates.</p>
        </div>
    </div>

    <div class="settings-grid">
        <div>
            <section class="panel" id="folders">
                <h2>Folders</h2>
                <div class="field">
                    <span class="label">Folders to scan</span>
                    <div class="help">Sub folders are included.</div>
                    <ListEditor Items="contentFolders" Label="folder to scan" Placeholder="@(OperatingSystem.IsWindows() ? @"D:\Videos or \\nas\videos" : "/mnt/videos")" Browse="true" Changed="Edited" />
                </div>
                <div class="field">
                    <span class="label">Skip paths that contain</span>
                    <div class="help">Any part of a path, for example a folder name.</div>
                    <ListEditor Items="excludePaths" Label="path to skip" Placeholder="e.g. Samples" Changed="Edited" />
                </div>
                <div class="field">
                    <span class="label">Prefer keeping copies in</span>
                    <div class="help">When copies are found, the one in these folders is kept.</div>
                    <ListEditor Items="priorityFolders" Label="preferred folder" Placeholder="Folder" Browse="true" Changed="Edited" />
                </div>
            </section>

            <section class="panel">
                <h2>Windows and Linux paths</h2>
                <div class="help muted" style="margin-bottom:12px">
                    Lets Windows and Linux share the database. Each row says where the same storage is found on each system.
                    The Linux side must be a mounted folder, like /mnt/videos.
                </div>
                <div class="mapping head"><span>On Windows</span><span>On Linux</span><span></span></div>
                @for (int i = 0; i < mappings.Count; i++)
                {
                    int index = i;
                    var check = checks.TryGetValue(mappings[index], out var c) ? c : null;
                    <div class="mapping" style="margin-top:6px">
                        <input type="text" @bind="mappings[index].Windows" @bind:after="() => MappingEdited(index)" placeholder="L:\" aria-label="Windows path @(index + 1)" />
                        <input type="text" @bind="mappings[index].Linux" @bind:after="() => MappingEdited(index)" placeholder="/mnt/architecture" aria-label="Linux path @(index + 1)" />
                        <button @onclick="() => RemoveMapping(index)">Remove</button>
                    </div>
                    @if (!string.IsNullOrEmpty(check?.Message))
                    {
                        <div class="mapcheck @check.Level.ToString().ToLowerInvariant()" role="status">@check.Message</div>
                    }
                }
                <p style="margin-top:10px"><button @onclick="() => { mappings.Add(new PathMapping()); Edited(); }">Add a path pair</button></p>
                <div class="testpath">
                    <label for="testpath" class="label" style="font-weight:600">Try a path</label>
                    <input id="testpath" type="text" @bind="testPath" @bind:event="oninput" placeholder="Paste a Windows or Linux path" />
                    @if (!string.IsNullOrWhiteSpace(testPath)) { <div class="result">@TestResult()</div> }
                </div>
            </section>

            <section class="panel" id="synonyms">
                <h2>Other names for the same place</h2>
                <div class="help muted" style="margin-bottom:12px">
                    For example a mapped drive letter and the network path it points to (L:\ and \\nas\video\).
                    The main name is what the database uses - the network path is best, because it works on every computer.
                    Each computer uses whichever of the names it can reach.
                </div>
                <div class="mapping head"><span>Main name (network path)</span><span>Also known as</span><span></span></div>
                @for (int i = 0; i < synonyms.Count; i++)
                {
                    int index = i;
                    var syn = synonyms[index];
                    var sc = synChecks.TryGetValue(syn, out var c2) ? c2 : null;
                    <div class="mapping" style="margin-top:6px">
                        <input type="text" @bind="syn.Main" @bind:after="() => SynonymEdited(syn)" placeholder="\\nas\video\" aria-label="Main name @(index + 1)" />
                        <input type="text" @bind="syn.Alias" @bind:after="() => SynonymEdited(syn)" placeholder="L:\" aria-label="Also known as @(index + 1)" />
                        <button @onclick="() => RemoveSynonym(index)">Remove</button>
                    </div>
                    @if (!string.IsNullOrEmpty(sc?.Message))
                    {
                        <div class="mapcheck @sc.Level.ToString().ToLowerInvariant()" role="status">
                            @sc.Message
                            @if (sc.InDatabase > 0 && sc.Level is MappingCheckLevel.Ok or MappingCheckLevel.Warning)
                            {
                                <div style="margin-top:8px"><button class="primary" @onclick="() => confirmSynonym = syn">Update paths</button></div>
                            }
                        </div>
                    }
                }
                <p style="margin-top:10px"><button @onclick="AddSynonym">Add a synonym</button></p>
            </section>

            <section class="panel">
                <h2>When are videos duplicates?</h2>
                <p class="muted" style="margin-bottom:16px">Videos of the same length (within a second) are compared using 3 screenshots each.</p>
                <MatchEditor Value="settings.matchSettings" Id="main" Changed="Edited" />

                <div class="field" style="margin-top:24px">
                    <label class="inline"><input type="checkbox" checked="@(settings.matchSettings_sameFolder != null)" @onchange="ToggleSameFolder" /> Use other rules for copies in folders with the same name</label>
                    <div class="help">For example looser rules for re-encoded copies that sit next to each other.</div>
                </div>
                @if (settings.matchSettings_sameFolder != null)
                {
                    <MatchEditor Value="settings.matchSettings_sameFolder" Id="same" Changed="Edited" />
                }
            </section>

            <section class="panel" id="false-positives">
                <h2>False positives</h2>
                <p class="muted" style="margin-bottom:12px">
                    Videos you marked as "Not a duplicate" in Review are never matched with each other again, even after they are moved or renamed.
                    @(falsePositiveCount == 0 ? "None are marked yet." : $"{Fmt.Plural(falsePositiveCount, "pair is", "pairs are")} marked.")
                </p>
                <a class="button" href="settings/false-positives">Review false positives</a>
            </section>

            <section class="panel" id="encoding">
                <h2>Re-encoding</h2>
                <p class="muted" style="margin-bottom:16px">How the Re-encode screen makes smaller copies of large videos. The defaults are the recommended settings.</p>
                <EncodeEditor Value="settings.encodeSettings" Changed="Edited" />
            </section>

            <section class="panel">
                <h2>Short, small and preferred versions</h2>
                <div class="field">
                    <label for="minlen">Remove videos this short or shorter</label>
                    <div class="inline"><input id="minlen" type="number" min="0" @bind="settings.minVideoLength" @bind:after="Edited" /> seconds</div>
                </div>
                <div class="field">
                    <label for="minsize">Remove videos smaller than</label>
                    <div class="inline"><input id="minsize" type="number" min="0" @bind="settings.minVideoSizeKb" @bind:after="Edited" /> KB (0 = off)</div>
                </div>
                <div class="field">
                    <span class="label">Prefer one version over another</span>
                    <div class="help">If the path of one copy contains the first text and the other copy the second, keep the first when their sizes are close.</div>
                    @for (int i = 0; i < switches.Count; i++)
                    {
                        int index = i;
                        <div class="inline" style="margin-top:6px">
                            Keep <input type="text" style="width:90px" @bind="switches[index].up" @bind:after="Edited" aria-label="Preferred text" />
                            over <input type="text" style="width:90px" @bind="switches[index].down" @bind:after="Edited" aria-label="Other text" />
                            when sizes differ by less than <input type="number" @bind="switches[index].triggerBelowPctSizeDiff" @bind:after="Edited" aria-label="Percent" /> %
                            <button @onclick="() => { switches.RemoveAt(index); Edited(); }">Remove</button>
                        </div>
                    }
                    <p style="margin-top:8px"><button @onclick="AddSwitch">Add a rule</button></p>
                </div>
            </section>
        </div>

        <aside class="panel preview" aria-live="polite">
            <div class="buttons">
                <button class="primary" @onclick="Save" disabled="@(!dirty)">Save settings</button>
                <button @onclick="SaveAndCompare" disabled="@App.Scanner.IsRunning" title="Saves, then updates the review with the videos already read">Save and compare again</button>
                @if (savedMessage != null) { <span class="saved" role="status">@savedMessage</span> }
            </div>
        </aside>
    </div>
</div>

@if (confirmSynonym != null)
{
    var pending = synChecks.TryGetValue(confirmSynonym, out var pc) ? pc : null;
    <div class="dialog-backdrop" @onclick="() => confirmSynonym = null">
        <div class="dialog" role="alertdialog" aria-modal="true" aria-labelledby="syn-confirm" @onclick:stopPropagation="true">
            <h2 id="syn-confirm">Update @Fmt.Plural(pending?.InDatabase ?? 0, "path", "paths") in the database?</h2>
            <p>Paths starting with @PathMapper.NormalizeRoot(confirmSynonym.Alias) are changed to start with @PathMapper.NormalizeRoot(confirmSynonym.Main). Videos stored under both names become one. Your settings are saved too, so new scans use the main name. This can't be undone.</p>
            <div class="buttons">
                <button @onclick="() => confirmSynonym = null">Cancel</button>
                <button class="primary" @onclick="UpdateSynonymPaths" disabled="@updating">@(updating ? "Updating..." : "Update paths")</button>
            </div>
        </div>
    </div>
}

@code {
    private deepduplicates.Settings settings = new();
    private List<string> contentFolders = new(), excludePaths = new(), priorityFolders = new();
    private List<PathMapping> mappings = new();
    private List<switchPrioritySet> switches = new();
    private string testPath = "";
    private bool dirty;
    private string savedMessage;
    private int falsePositiveCount;
    // Synonyms (other names for the same place) and their checks
    private List<PathSynonym> synonyms = new();
    private readonly System.Collections.Concurrent.ConcurrentDictionary<PathSynonym, MappingCheck> synChecks = new();
    private readonly System.Collections.Concurrent.ConcurrentDictionary<PathSynonym, CancellationTokenSource> synRuns = new();
    private PathSynonym confirmSynonym;
    private bool updating;
    // Background checks of the path pairs against the database, one per row
    private readonly System.Collections.Concurrent.ConcurrentDictionary<PathMapping, MappingCheck> checks = new();
    private readonly System.Collections.Concurrent.ConcurrentDictionary<PathMapping, CancellationTokenSource> checkRuns = new();

    protected override void OnInitialized()
    {
        settings = App.Settings.Clone();
        settings.encodeSettings ??= EncodeSettings.CreateDefault();
        contentFolders = settings.contentFolders.ToList();
        excludePaths = settings.excludePaths.ToList();
        priorityFolders = settings.priorityFolders.ToList();
        switches = settings.switchPriority.ToList();
        mappings = PathMapper.Mappings.Select(m => new PathMapping { Windows = m.Windows, Linux = m.Linux }).ToList();
        falsePositiveCount = FalsePositives.Count;
        foreach (var m in mappings) StartCheck(m, 0);
        synonyms = PathMapper.Synonyms.Select(s => new PathSynonym { Main = s.Main, Alias = s.Alias }).ToList();
        foreach (var s in synonyms) StartSynonymCheck(s, 0);
    }

    private void AddSynonym() { synonyms.Add(new PathSynonym()); Edited(); }

    private void SynonymEdited(PathSynonym s) { Edited(); StartSynonymCheck(s, 500); }

    private void RemoveSynonym(int index)
    {
        var s = synonyms[index];
        if (synRuns.TryRemove(s, out var run)) run.Cancel();
        synChecks.TryRemove(s, out _);
        synonyms.RemoveAt(index);
        Edited();
    }

    // Counts the videos stored under the alias and checks a sample of them under the main name
    private void StartSynonymCheck(PathSynonym s, int delayMs)
    {
        if (synRuns.TryRemove(s, out var old)) old.Cancel();
        if (string.IsNullOrWhiteSpace(s.Main) || string.IsNullOrWhiteSpace(s.Alias)) { synChecks.TryRemove(s, out _); return; }
        var cts = new CancellationTokenSource();
        synRuns[s] = cts;
        var token = cts.Token;
        var snapshot = new PathSynonym { Main = s.Main, Alias = s.Alias };
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(delayMs, token);
                var progress = new SyncProgress<MappingCheck>(p => { if (!token.IsCancellationRequested) { synChecks[s] = p; InvokeAsync(StateHasChanged); } });
                var result = await SynonymTools.CheckAsync(snapshot, progress, token);
                if (token.IsCancellationRequested) return;
                synChecks[s] = result;
            }
            catch (OperationCanceledException) { return; }
            catch (Exception ex) { synChecks[s] = new MappingCheck(MappingCheckLevel.Warning, "Could not check this synonym: " + ex.Message); }
            await InvokeAsync(StateHasChanged);
        });
    }

    // Saves the settings (so new scans use the main name) and rewrites the stored paths once
    private async Task UpdateSynonymPaths()
    {
        var s = confirmSynonym;
        if (s == null) return;
        updating = true;
        Save();
        var report = await Task.Run(() => App.UpdateSynonymPaths(s));
        updating = false;
        confirmSynonym = null;
        synChecks[s] = new MappingCheck(report.Updated + report.Merged > 0 ? MappingCheckLevel.Ok : MappingCheckLevel.Warning, report.Message);
        foreach (var m in mappings) StartCheck(m, 0);
    }

    private void MappingEdited(int index)
    {
        Edited();
        StartCheck(mappings[index], 500);
    }

    private void RemoveMapping(int index)
    {
        var m = mappings[index];
        if (checkRuns.TryRemove(m, out var run)) run.Cancel();
        checks.TryRemove(m, out _);
        mappings.RemoveAt(index);
        Edited();
    }

    // Checks a sample of the videos in the database against the pair, a moment after the last change
    private void StartCheck(PathMapping m, int delayMs)
    {
        if (checkRuns.TryRemove(m, out var old)) old.Cancel();
        if (string.IsNullOrWhiteSpace(m.Windows) || string.IsNullOrWhiteSpace(m.Linux)) { checks.TryRemove(m, out _); return; }
        var cts = new CancellationTokenSource();
        checkRuns[m] = cts;
        var token = cts.Token;
        var snapshot = new PathMapping { Windows = m.Windows, Linux = m.Linux };
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(delayMs, token);
                var progress = new SyncProgress<MappingCheck>(p => { if (!token.IsCancellationRequested) { checks[m] = p; InvokeAsync(StateHasChanged); } });
                var result = await MappingChecker.CheckAsync(snapshot, progress, token);
                if (token.IsCancellationRequested) return;
                checks[m] = result;
            }
            catch (OperationCanceledException) { return; }
            catch (Exception ex) { checks[m] = new MappingCheck(MappingCheckLevel.Warning, "Could not check this path: " + ex.Message); }
            await InvokeAsync(StateHasChanged);
        });
    }

    private deepduplicates.Settings Current()
    {
        settings.contentFolders = contentFolders.Where(s => !string.IsNullOrWhiteSpace(s)).ToArray();
        settings.excludePaths = excludePaths.Where(s => !string.IsNullOrWhiteSpace(s)).ToArray();
        settings.priorityFolders = priorityFolders.Where(s => !string.IsNullOrWhiteSpace(s)).ToArray();
        settings.switchPriority = switches.Where(s => !string.IsNullOrWhiteSpace(s.up) && !string.IsNullOrWhiteSpace(s.down)).ToArray();
        return settings;
    }

    private void Edited()
    {
        dirty = true;
        savedMessage = null;
    }

    private void AddSwitch()
    {
        switches.Add(new switchPrioritySet { up = "x265", down = "x264", triggerBelowPctSizeDiff = 15 });
        Edited();
    }

    private void ToggleSameFolder(ChangeEventArgs e)
    {
        settings.matchSettings_sameFolder = (bool)e.Value! ? settings.matchSettings.Clone() : null;
        Edited();
    }

    private void Save()
    {
        App.SaveSettings(Current().Clone(), mappings, synonyms);
        dirty = false;
        savedMessage = "Saved";
    }

    private async Task SaveAndCompare()
    {
        Save();
        await Task.Run(App.ReanalyzeFromDatabase);
        savedMessage = "Saved and compared - see Review";
    }

    // Shows what a path becomes on this computer with the mappings as currently edited
    private string TestResult()
    {
        var local = PathMapper.PreviewLocal(testPath.Trim(), mappings);
        bool exists = Directory.Exists(local) || File.Exists(local);
        return $"On this computer: {local} ({(exists ? "found" : "not found")})";
    }

    public void Dispose()
    {
        foreach (var run in checkRuns.Values) run.Cancel();
        foreach (var run in synRuns.Values) run.Cancel();
    }
}
