<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DuplicateVideoRemover.Desktop.ViewModels"
             xmlns:v="using:DuplicateVideoRemover.Desktop.Views"
             x:Class="DuplicateVideoRemover.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             x:Name="Root">
  <UserControl.Styles>
    <Style Selector="Border.mapcheck"><Setter Property="Background" Value="{DynamicResource Table}"/></Style>
    <Style Selector="Border.mapcheck TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Style>
    <Style Selector="Border.mapcheck.ok"><Setter Property="Background" Value="{DynamicResource KeepWash}"/></Style>
    <Style Selector="Border.mapcheck.ok TextBlock"><Setter Property="Foreground" Value="{DynamicResource Keep}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Border.mapcheck.warning"><Setter Property="Background" Value="{DynamicResource WarnWash}"/></Style>
    <Style Selector="Border.mapcheck.warning TextBlock"><Setter Property="Foreground" Value="{DynamicResource Warn}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Border.mapcheck.error"><Setter Property="Background" Value="{DynamicResource GreaseWash}"/></Style>
    <Style Selector="Border.mapcheck.error TextBlock"><Setter Property="Foreground" Value="{DynamicResource Grease}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>

    <!-- Section header: a coloured icon tile, title and one-line summary. Each section has its own colour so it is
         easy to recognise while scrolling; the same tile is used in the "On this page" list. -->
    <Style Selector="Border.tile">
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style Selector="Border.tile PathIcon"><Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/></Style>
    <Style Selector="Border.tile.mini"><Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/><Setter Property="CornerRadius" Value="7"/></Style>
    <Style Selector="Border.tile.mini PathIcon"><Setter Property="Width" Value="13"/><Setter Property="Height" Value="13"/></Style>
    <Style Selector="Border.tile.blue"><Setter Property="Background" Value="#265B9BF5"/></Style>
    <Style Selector="Border.tile.blue PathIcon"><Setter Property="Foreground" Value="#5B9BF5"/></Style>
    <Style Selector="Border.tile.teal"><Setter Property="Background" Value="#262EC4B6"/></Style>
    <Style Selector="Border.tile.teal PathIcon"><Setter Property="Foreground" Value="#2EC4B6"/></Style>
    <Style Selector="Border.tile.violet"><Setter Property="Background" Value="#26A78BFA"/></Style>
    <Style Selector="Border.tile.violet PathIcon"><Setter Property="Foreground" Value="#A78BFA"/></Style>
    <Style Selector="Border.tile.indigo"><Setter Property="Background" Value="#266573F2"/></Style>
    <Style Selector="Border.tile.indigo PathIcon"><Setter Property="Foreground" Value="#7B87F7"/></Style>
    <Style Selector="Border.tile.red"><Setter Property="Background" Value="#26F2605A"/></Style>
    <Style Selector="Border.tile.red PathIcon"><Setter Property="Foreground" Value="#F2605A"/></Style>
    <Style Selector="Border.tile.amber"><Setter Property="Background" Value="#26F2B84B"/></Style>
    <Style Selector="Border.tile.amber PathIcon"><Setter Property="Foreground" Value="#E0A63A"/></Style>
    <Style Selector="Border.tile.green"><Setter Property="Background" Value="#264FCF8E"/></Style>
    <Style Selector="Border.tile.green PathIcon"><Setter Property="Foreground" Value="#3FBF7E"/></Style>
    <Style Selector="DockPanel.sechead > Border.tile"><Setter Property="Margin" Value="0,0,14,0"/></Style>
    <!-- Section contents line up with the title, behind a thin guide line -->
    <Style Selector="Border.secbody">
      <Setter Property="Margin" Value="18,16,0,0"/>
      <Setter Property="Padding" Value="33,2,0,2"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Rule}"/>
      <Setter Property="BorderThickness" Value="2,0,0,0"/>
    </Style>
    <!-- A labelled group inside a section: small icon + label, contents indented under the label -->
    <Style Selector="DockPanel.subhead PathIcon">
      <Setter Property="Width" Value="14"/>
      <Setter Property="Height" Value="14"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    </Style>
    <Style Selector="StackPanel.subbody"><Setter Property="Margin" Value="22,2,0,0"/></Style>
    <!-- "On this page" list -->
    <Style Selector="Button.jump">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    </Style>
    <Style Selector="Button.jump:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Raised}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    </Style>
    <Style Selector="Button.jump.current">
      <Setter Property="Background" Value="{DynamicResource Raised}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="*,300" ColumnSpacing="20" Margin="12,16,12,12">
    <ScrollViewer Grid.Column="0" Classes="gutter" x:Name="Scroller">
      <StackPanel Spacing="16" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Classes="h1" Text="Settings"/>
          <TextBlock Classes="muted" Text="Which folders to scan and how alike two videos must be to count as duplicates." Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Where this app keeps its own files -->
        <Border Background="{DynamicResource AccentWash}" CornerRadius="10" Padding="16,12">
          <DockPanel>
            <PathIcon DockPanel.Dock="Left" Width="20" Height="20" Margin="0,2,14,0" VerticalAlignment="Top"
                      Foreground="{DynamicResource AccentHover}"
                      Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/>
            <StackPanel Spacing="3">
              <TextBlock Text="Data folder" FontWeight="SemiBold"/>
              <SelectableTextBlock Text="{Binding DataFolder}" TextWrapping="Wrap"/>
              <SelectableTextBlock Text="{Binding DatabaseFolder, StringFormat='Database: {0}'}" TextWrapping="Wrap" IsVisible="{Binding HasSeparateDatabase}"/>
              <TextBlock Classes="muted small" Text="Settings, the database and screenshots are kept here." TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- The sections; the "On this page" buttons point at them by name (Tag) -->
        <StackPanel x:Name="Sections" Spacing="16">
          <Border Classes="panel" x:Name="SecFolders">
            <StackPanel>
              <DockPanel Classes="sechead">
                <Border Classes="tile blue"><PathIcon Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></Border>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="h2" Text="Folders"/>
                  <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Where to look for videos, what to skip, and which copies to keep."/>
                </StackPanel>
              </DockPanel>
              <Border Classes="secbody">
                <StackPanel Spacing="18">
                  <StackPanel Spacing="4">
                    <DockPanel Classes="subhead">
                      <PathIcon DockPanel.Dock="Left" Data="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                      <TextBlock Text="Folders to scan" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel Classes="subbody" Spacing="4">
                      <TextBlock Classes="muted small" Text="Sub folders are included." TextWrapping="Wrap"/>
                      <v:PathListEditor DataContext="{Binding ContentFolders}" Tag="{Binding #Root.((vm:SettingsViewModel)DataContext).Placeholder}"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <DockPanel Classes="subhead">
                      <PathIcon DockPanel.Dock="Left" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zM4 12c0-4.42 3.58-8 8-8 1.85 0 3.55.63 4.9 1.69L5.69 16.9A7.902 7.902 0 0 1 4 12zm8 8c-1.85 0-3.55-.63-4.9-1.69L18.31 7.1A7.902 7.902 0 0 1 20 12c0 4.42-3.58 8-8 8z"/>
                      <TextBlock Text="Skip paths that contain" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel Classes="subbody" Spacing="4">
                      <TextBlock Classes="muted small" Text="Any part of a path, for example a folder name." TextWrapping="Wrap"/>
                      <v:PathListEditor DataContext="{Binding ExcludePaths}" Tag="e.g. Samples"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <DockPanel Classes="subhead">
                      <PathIcon DockPanel.Dock="Left" Data="M12 17.27L18.18 21l-1.64-7.19L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.55L5.82 21z"/>
                      <TextBlock Text="Prefer keeping copies in" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel Classes="subbody" Spacing="4">
                      <TextBlock Classes="muted small" Text="When copies are found, the one in these folders is kept." TextWrapping="Wrap"/>
                      <v:PathListEditor DataContext="{Binding PriorityFolders}" Tag="Folder"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Classes="panel" x:Name="SecPaths">
            <StackPanel>
              <DockPanel Classes="sechead">
                <Border Classes="tile teal"><PathIcon Data="M6.99 11L3 15l3.99 4v-3H14v-2H6.99v-3zM21 9l-3.99-4v3H10v2h7.01v3L21 9z"/></Border>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="h2" Text="Windows and Linux paths"/>
                  <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Lets Windows and Linux share the database. Each row says where the same storage is found on each system. The Linux side must be a mounted folder, like /mnt/videos."/>
                </StackPanel>
              </DockPanel>
              <Border Classes="secbody">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="6">
                    <TextBlock Classes="muted small" Text="On Windows"/>
                    <TextBlock Grid.Column="1" Classes="muted small" Text="On Linux"/>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Mappings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MappingItem">
                        <StackPanel Margin="0,0,0,6" Spacing="4">
                          <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="6">
                            <TextBox Text="{Binding Windows}" PlaceholderText="L:\"/>
                            <TextBox Grid.Column="1" Text="{Binding Linux}" PlaceholderText="/mnt/architecture"/>
                            <Button Grid.Column="2" Content="Remove" Command="{Binding #Root.((vm:SettingsViewModel)DataContext).RemoveMappingCommand}" CommandParameter="{Binding}"/>
                          </Grid>
                          <!-- Background check of the pair against the database -->
                          <Border IsVisible="{Binding HasCheck}" CornerRadius="6" Padding="10,6" Classes="mapcheck"
                                  Classes.ok="{Binding IsOk}" Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsError}">
                            <TextBlock Text="{Binding CheckText}" TextWrapping="Wrap" FontSize="12"/>
                          </Border>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Content="Add a path pair" Command="{Binding AddMappingCommand}"/>
                  <Panel Height="8"/>
                  <StackPanel Spacing="4">
                    <DockPanel Classes="subhead">
                      <PathIcon DockPanel.Dock="Left" Data="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"/>
                      <TextBlock Text="Try a path" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel Classes="subbody" Spacing="4">
                      <TextBox Text="{Binding TestPath}" PlaceholderText="Paste a Windows or Linux path"/>
                      <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Classes="panel" x:Name="SecNames">
            <StackPanel>
              <DockPanel Classes="sechead">
                <Border Classes="tile violet"><PathIcon Data="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></Border>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="h2" Text="Other names for the same place"/>
                  <TextBlock Classes="muted small" TextWrapping="Wrap" Text="For example a mapped drive letter and the network path it points to (L:\ and \\nas\video\). The main name is what the database uses - the network path is best, because it works on every computer. Each computer uses whichever of the names it can reach."/>
                </StackPanel>
              </DockPanel>
              <Border Classes="secbody">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="6">
                    <TextBlock Classes="muted small" Text="Main name (network path)"/>
                    <TextBlock Grid.Column="1" Classes="muted small" Text="Also known as"/>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Synonyms}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SynonymItem">
                        <StackPanel Margin="0,0,0,6" Spacing="4">
                          <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="6">
                            <TextBox Text="{Binding Main}" PlaceholderText="\\nas\video\"/>
                            <TextBox Grid.Column="1" Text="{Binding Alias}" PlaceholderText="L:\"/>
                            <Button Grid.Column="2" Content="Remove" Command="{Binding #Root.((vm:SettingsViewModel)DataContext).RemoveSynonymCommand}" CommandParameter="{Binding}"/>
                          </Grid>
                          <Border IsVisible="{Binding HasCheck}" CornerRadius="6" Padding="10,6" Classes="mapcheck"
                                  Classes.ok="{Binding IsOk}" Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsError}">
                            <StackPanel Spacing="8">
                              <TextBlock Text="{Binding CheckText}" TextWrapping="Wrap" FontSize="12"/>
                              <Button Classes="primary" Content="Update paths" Command="{Binding UpdateCommand}" IsVisible="{Binding CanUpdate}" HorizontalAlignment="Left"/>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Content="Add a synonym" Command="{Binding AddSynonymCommand}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Classes="panel" x:Name="SecMatch">
            <StackPanel>
              <DockPanel Classes="sechead">
                <Border Classes="tile indigo"><PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></Border>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="h2" Text="When are videos duplicates?"/>
                  <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Videos of the same length (within a second) are compared using 3 screenshots each."/>
                </StackPanel>
              </DockPanel>
              <Border Classes="secbody">
                <StackPanel Spacing="18">
                  <v:MatchEditor DataContext="{Binding Match}"/>
                  <StackPanel Spacing="4">
                    <CheckBox IsChecked="{Binding UseSameFolder}" Content="Use other rules for copies in folders with the same name"/>
                    <StackPanel Classes="subbody" Spacing="10">
                      <TextBlock Classes="muted small" Text="For example looser rules for re-encoded copies that sit next to each other." TextWrapping="Wrap"/>
                      <v:MatchEditor DataContext="{Binding SameFolder}" IsVisible="{Binding #Root.((vm:SettingsViewModel)DataContext).UseSameFolder}"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Classes="panel" x:Name="SecFalse">
            <StackPanel>
              <DockPanel Classes="sechead">
                <Border Classes="tile red"><PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zM4 12c0-4.42 3.58-8 8-8 1.85 0 3.55.63 4.9 1.69L5.69 16.9A7.902 7.902 0 0 1 4 12zm8 8c-1.85 0-3.55-.63-4.9-1.69L18.31 7.1A7.902 7.902 0 0 1 20 12c0 4.42-3.58 8-8 8z"/></Border>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="h2" Text="False positives"/>
                  <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Pairs you marked in Review as not being duplicates."/>
                </StackPanel>
              </DockPanel>
              <Border Classes="secbody">
                <StackPanel Spacing="12">
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding FalsePositivesText}"/>
                  <Button Content="Review false positives" Command="{Binding OpenFalsePositivesCommand}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Classes="panel" x:Name="SecEncode">
            <StackPanel>
              <DockPanel Classes="sechead">
                <Border Classes="tile amber"><PathIcon Data="M18 4l2 4h-3l-2-4h-2l2 4h-3l-2-4H8l2 4H7L5 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4h-4z"/></Border>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="h2" Text="Re-encoding"/>
                  <TextBlock Classes="muted small" TextWrapping="Wrap" Text="How the Re-encode screen makes smaller copies of large videos. The defaults are the recommended settings."/>
                </StackPanel>
              </DockPanel>
              <Border Classes="secbody">
                <v:EncodeSettingsEditor DataContext="{Binding Encoding}"/>
              </Border>
            </StackPanel>
          </Border>

          <Border Classes="panel" x:Name="SecShort">
            <StackPanel>
              <DockPanel Classes="sechead">
                <Border Classes="tile green"><PathIcon Data="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z"/></Border>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="h2" Text="Short, small and preferred versions"/>
                  <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Videos that are always removed, and which version wins between near-equal copies."/>
                </StackPanel>
              </DockPanel>
              <Border Classes="secbody">
                <StackPanel Spacing="18">
                  <StackPanel Spacing="4">
                    <DockPanel Classes="subhead">
                      <PathIcon DockPanel.Dock="Left" Data="M15 1H9v2h6V1zm-4 13h2V8h-2v6zm8.03-6.61l1.42-1.42c-.43-.51-.9-.99-1.41-1.41l-1.42 1.42A8.962 8.962 0 0 0 12 4c-4.97 0-9 4.03-9 9s4.02 9 9 9 9-4.03 9-9c0-2.12-.74-4.07-1.97-5.61zM12 20c-3.87 0-7-3.13-7-7s3.13-7 7-7 7 3.13 7 7-3.13 7-7 7z"/>
                      <TextBlock Text="Too short or too small" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel Classes="subbody" Spacing="4">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Remove videos this short or shorter" VerticalAlignment="Center" Width="240"/>
                        <NumericUpDown Value="{Binding MinLength}" Minimum="0" Increment="1" FormatString="0" Width="130"/>
                        <TextBlock Text="seconds" VerticalAlignment="Center"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Remove videos smaller than" VerticalAlignment="Center" Width="240"/>
                        <NumericUpDown Value="{Binding MinSizeKb}" Minimum="0" Increment="100" FormatString="0" Width="130"/>
                        <TextBlock Text="KB (0 = off)" VerticalAlignment="Center"/>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <DockPanel Classes="subhead">
                      <PathIcon DockPanel.Dock="Left" Data="M16 17.01V10h-2v7.01h-3L15 21l4-3.99h-3zM9 3L5 6.99h3V14h2V6.99h3L9 3z"/>
                      <TextBlock Text="Prefer one version over another" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel Classes="subbody" Spacing="4">
                      <TextBlock Classes="muted small" Text="If the path of one copy contains the first text and the other copy the second, keep the first when their sizes are close." TextWrapping="Wrap"/>
                      <ItemsControl ItemsSource="{Binding Switches}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SwitchItem">
                            <WrapPanel Margin="0,0,0,6">
                              <TextBlock Text="Keep" VerticalAlignment="Center" Margin="0,0,6,0"/>
                              <TextBox Text="{Binding Up}" Width="90"/>
                              <TextBlock Text="over" VerticalAlignment="Center" Margin="6,0"/>
                              <TextBox Text="{Binding Down}" Width="90"/>
                              <TextBlock Text="when sizes differ by less than" VerticalAlignment="Center" Margin="6,0"/>
                              <NumericUpDown Value="{Binding Percent}" Minimum="0" Maximum="100" FormatString="0" Width="110"/>
                              <TextBlock Text="%" VerticalAlignment="Center" Margin="6,0"/>
                              <Button Content="Remove" Command="{Binding #Root.((vm:SettingsViewModel)DataContext).RemoveSwitchCommand}" CommandParameter="{Binding}"/>
                            </WrapPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Button Content="Add a rule" Command="{Binding AddSwitchCommand}"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Save, and a list of the sections that jumps to them and shows where you are -->
    <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Top">
      <Border Classes="panel">
        <StackPanel Spacing="10">
          <Button Classes="primary" Content="Save settings" Command="{Binding SaveCommand}" IsEnabled="{Binding Dirty}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          <Button Content="Save and compare again" Command="{Binding SaveAndCompareCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  ToolTip.Tip="Saves, then updates the review with the videos already read"/>
          <TextBlock Text="{Binding SavedMessage}" Foreground="{DynamicResource Keep}" FontWeight="SemiBold"/>
        </StackPanel>
      </Border>
      <Border Classes="panel" Padding="12,14">
        <StackPanel Spacing="2" x:Name="Jumps">
          <TextBlock Text="ON THIS PAGE" Classes="muted" FontSize="11" FontWeight="SemiBold" LetterSpacing="0.8" Margin="8,0,0,8"/>
          <Button Classes="jump" Tag="SecFolders" Click="Jump_Click">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="tile mini blue"><PathIcon Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></Border>
              <TextBlock Text="Folders" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Classes="jump" Tag="SecPaths" Click="Jump_Click">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="tile mini teal"><PathIcon Data="M6.99 11L3 15l3.99 4v-3H14v-2H6.99v-3zM21 9l-3.99-4v3H10v2h7.01v3L21 9z"/></Border>
              <TextBlock Text="Windows and Linux paths" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Classes="jump" Tag="SecNames" Click="Jump_Click">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="tile mini violet"><PathIcon Data="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></Border>
              <TextBlock Text="Other names" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Classes="jump" Tag="SecMatch" Click="Jump_Click">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="tile mini indigo"><PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></Border>
              <TextBlock Text="When are videos duplicates?" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Classes="jump" Tag="SecFalse" Click="Jump_Click">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="tile mini red"><PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zM4 12c0-4.42 3.58-8 8-8 1.85 0 3.55.63 4.9 1.69L5.69 16.9A7.902 7.902 0 0 1 4 12zm8 8c-1.85 0-3.55-.63-4.9-1.69L18.31 7.1A7.902 7.902 0 0 1 20 12c0 4.42-3.58 8-8 8z"/></Border>
              <TextBlock Text="False positives" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Classes="jump" Tag="SecEncode" Click="Jump_Click">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="tile mini amber"><PathIcon Data="M18 4l2 4h-3l-2-4h-2l2 4h-3l-2-4H8l2 4H7L5 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4h-4z"/></Border>
              <TextBlock Text="Re-encoding" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Classes="jump" Tag="SecShort" Click="Jump_Click">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="tile mini green"><PathIcon Data="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z"/></Border>
              <TextBlock Text="Short, small and preferred" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Sub page: the marked false positives -->
    <DockPanel Grid.ColumnSpan="2" Margin="-12,-16,-12,-12" Background="{DynamicResource Table}" IsVisible="{Binding FalsePositivesVisible}">
      <DockPanel DockPanel.Dock="Top" Margin="12,16,12,12">
        <Button DockPanel.Dock="Right" Content="Back to settings" Command="{Binding CloseFalsePositivesCommand}" VerticalAlignment="Bottom"/>
        <StackPanel>
          <TextBlock Classes="h1" Text="False positives"/>
          <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,4,0,0"
                     Text="Videos marked as &quot;False positive&quot; in Review. They are recognised by their content, so a mark still applies after the files are moved or renamed."/>
          <TextBlock Text="{Binding FalsePositivesStatus}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
      </DockPanel>
      <ScrollViewer Margin="12,0,12,12" Classes="gutter">
        <ItemsControl ItemsSource="{Binding FalsePositiveItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FalsePositiveItem">
              <Border Classes="panel" Padding="0" Margin="0,0,0,12">
                <StackPanel>
                  <DockPanel Margin="14,8">
                    <Button DockPanel.Dock="Right" Content="Remove" Command="{Binding RemoveCommand}" ToolTip.Tip="These two can be found as duplicates again"/>
                    <TextBlock Classes="muted small" Text="{Binding Heading}" VerticalAlignment="Center"/>
                  </DockPanel>
                  <ContentControl Content="{Binding A}"/>
                  <ContentControl Content="{Binding B}"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
          <ItemsControl.DataTemplates>
            <DataTemplate DataType="vm:FalsePositiveVideo">
              <Border BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="14,10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                  <Border Background="{DynamicResource Frame}" CornerRadius="3" Padding="4" Width="376" Height="88">
                    <Panel>
                      <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding InDatabase}">
                        <Image Source="{Binding Shot1}" Width="120" Height="80" Stretch="UniformToFill"/>
                        <Image Source="{Binding Shot2}" Width="120" Height="80" Stretch="UniformToFill"/>
                        <Image Source="{Binding Shot3}" Width="120" Height="80" Stretch="UniformToFill"/>
                      </StackPanel>
                      <TextBlock Text="Not in the database" Foreground="#9AA7B2" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !InDatabase}"/>
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Classes="muted small" Text="{Binding Folder}" TextWrapping="Wrap"/>
                    <TextBlock Classes="muted small" Text="{Binding Meta}"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <!-- "Update paths" confirmation -->
    <Grid Grid.ColumnSpan="2" Margin="-12,-16,-12,-12" Background="#80000000" IsVisible="{Binding ConfirmVisible}">
      <Border Classes="panel" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="{Binding ConfirmTitle}" TextWrapping="Wrap"/>
          <TextBlock Classes="muted" Text="{Binding ConfirmText}" TextWrapping="Wrap"/>
          <StackPanel Spacing="6" IsVisible="{Binding Updating}">
            <TextBlock Text="{Binding UpdateStep}"/>
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdatePercent}" IsIndeterminate="{Binding UpdateIndeterminate}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Command="{Binding CancelUpdateCommand}" IsEnabled="{Binding !Updating}"/>
            <Button Classes="primary" Content="Update paths" Command="{Binding ConfirmUpdateCommand}" IsEnabled="{Binding !Updating}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
