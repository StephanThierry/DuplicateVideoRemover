<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DuplicateVideoRemover.Desktop.ViewModels"
             xmlns:core="using:deepduplicates"
             x:Class="DuplicateVideoRemover.Desktop.Views.EncodeView"
             x:DataType="vm:EncodeViewModel">
  <UserControl.Styles>
    <Style Selector="ListBox.rows ListBoxItem"><Setter Property="Padding" Value="0"/></Style>
    <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Border.encrow"><Setter Property="Background" Value="{DynamicResource Sheet}"/><Setter Property="Padding" Value="12,6"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Rule}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
    <Style Selector="Border.encrow:pointerover"><Setter Property="Background" Value="{DynamicResource Table}"/></Style>
    <Style Selector="Border.encrow.picked"><Setter Property="Background" Value="{DynamicResource KeepWash}"/></Style>
    <!-- In the encode queue: greyed out, not clickable -->
    <Style Selector="Border.encrow.queued"><Setter Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Style>
    <Style Selector="Border.encrow.queued:pointerover"><Setter Property="Background" Value="{DynamicResource Sheet}"/></Style>
    <!-- Smaller screenshots in a narrow window; the number columns are only as wide as their contents -->
    <Style Selector="Image.shot"><Setter Property="Width" Value="96"/><Setter Property="Height" Value="64"/></Style>
    <ContainerQuery Name="enc" Query="max-width:1000">
      <Style Selector="Image.shot"><Setter Property="Width" Value="72"/><Setter Property="Height" Value="48"/></Style>
    </ContainerQuery>
    <Style Selector="TextBlock.saving"><Setter Property="Foreground" Value="{DynamicResource Keep}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="12,16,12,0">
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Classes="h1" Text="Re-encode planning"/>
      <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,4,0,0"
                 Text="Videos with the highest bitrate first - they usually shrink the most. Click a video to pick it, Shift-click to pick everything in between, then add them to the encode queue (or create a script)."/>
    </StackPanel>

    <Border Grid.Row="1" Classes="panel" Padding="16,12" Margin="0,0,0,12">
      <StackPanel Spacing="6">
        <WrapPanel>
          <TextBlock Text="{Binding SettingsSummary}" FontWeight="SemiBold" Margin="0,0,14,0" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding QualitySummary}" Classes="muted" Margin="0,0,14,0" VerticalAlignment="Center"/>
          <Button Classes="link" Content="Change in Settings" Command="{Binding EditSettingsCommand}"/>
        </WrapPanel>
        <!-- What is in the encode queue right now -->
        <WrapPanel IsVisible="{Binding HasQueueSummary}">
          <TextBlock Text="{Binding QueueSummary}" Margin="0,0,14,0" VerticalAlignment="Center"/>
          <Button Classes="link" Content="Open Re-encode queue" Command="{Binding OpenQueueCommand}"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" IsVisible="{Binding HasResult}" Background="{DynamicResource KeepWash}" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
      <StackPanel Spacing="6">
        <SelectableTextBlock Text="{Binding ResultText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <SelectableTextBlock Text="{Binding RunText}" Classes="muted" TextWrapping="Wrap"/>
        <Button Content="Open the folder" Command="{Binding ShowScriptFolderCommand}" HorizontalAlignment="Left"/>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="3" Margin="0,0,0,10" IsVisible="{Binding HasVideos}">
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="Search" VerticalAlignment="Center"/>
      <TextBox Text="{Binding Search}" PlaceholderText="e.g. vacation lisbon 2026 -ocean" Width="360" AutomationProperties.Name="Search"
               ToolTip.Tip="All words must be in the path, -word leaves out paths with that word, &quot;two words&quot; searches that exact phrase in that order; inside the quotes a regular expression works, e.g. &quot;night.?drive&quot;. Not case sensitive."/>
    </StackPanel>
    <WrapPanel>
      <Button Content="Select all" Command="{Binding SelectAllCommand}" Margin="0,0,8,6"/>
      <Button Content="Select top 20" Command="{Binding SelectTopCommand}" Margin="0,0,8,6"/>
      <Button Content="Select none" Command="{Binding SelectNoneCommand}" IsEnabled="{Binding HasPicked}" Margin="0,0,8,6"/>
      <Button Content="{Binding ManageHiddenText}" Command="{Binding ManageHiddenCommand}" Margin="0,0,8,6"
              ToolTip.Tip="See the folders that are hidden here, show them again one by one, or hide a folder (with everything below it)"/>
      <CheckBox Content="Hide videos in the queue" IsChecked="{Binding HideQueued}" IsVisible="{Binding HasQueueSummary}" Margin="0,0,8,6"/>
      <Panel Width="8"/>
      <TextBlock Text="Only above" VerticalAlignment="Center" Margin="0,0,6,6"/>
      <NumericUpDown Value="{Binding MinKbps}" Minimum="0" Increment="500" FormatString="0" Width="140" Margin="0,0,6,6"/>
      <TextBlock Text="kbit/s" VerticalAlignment="Center" Margin="0,0,16,6"/>
      <TextBlock Text="and above" VerticalAlignment="Center" Margin="0,0,6,6"/>
      <NumericUpDown Value="{Binding MinMb}" Minimum="0" Increment="50" FormatString="0" Width="140" Margin="0,0,6,6"/>
      <TextBlock Text="MB" VerticalAlignment="Center" Margin="0,0,16,6"/>
      <TextBlock Text="Sort by" VerticalAlignment="Center" Margin="0,0,6,6"/>
      <ComboBox ItemsSource="{Binding SortLabels}" SelectedIndex="{Binding SortIndex}" MinWidth="190" Margin="0,0,0,6"/>
    </WrapPanel>
    </StackPanel>

    <!-- Reading the list takes a few seconds: say so, instead of suggesting a new scan -->
    <Border Grid.Row="4" Classes="panel" Padding="40" VerticalAlignment="Top" IsVisible="{Binding Loading}">
      <StackPanel HorizontalAlignment="Center" Spacing="12" Width="460">
        <TextBlock Classes="h2" Text="Loading your videos..." HorizontalAlignment="Center"/>
        <ProgressBar IsIndeterminate="True" Height="10" CornerRadius="5"/>
        <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                   Text="Reading the videos from the last scan and checking which can be re-encoded. This takes a few seconds - no new scan is needed."/>
      </StackPanel>
    </Border>

    <Border Grid.Row="4" Classes="panel" Padding="40" VerticalAlignment="Top">
      <Border.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="!HasVideos"/>
          <Binding Path="!Loading"/>
        </MultiBinding>
      </Border.IsVisible>
      <StackPanel HorizontalAlignment="Center" Spacing="10">
        <TextBlock Classes="h2" Text="No videos to re-encode" HorizontalAlignment="Center"/>
        <TextBlock Classes="muted" Text="Scan your folders first. Duplicates, broken videos and left-out file types are not listed." HorizontalAlignment="Center"/>
        <Button Classes="primary" Content="Go to scan" Command="{Binding GoToScanCommand}" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Header and rows share their column widths (SharedSizeGroup) -->
    <Border Grid.Row="4" BorderBrush="{DynamicResource Rule}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" IsVisible="{Binding HasVideos}"
            Grid.IsSharedSizeScope="True" Container.Name="enc" Container.Sizing="Width">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource Table}" Padding="12,6,32,6">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="32"/>
              <ColumnDefinition Width="Auto" SharedSizeGroup="strip"/>
              <ColumnDefinition Width="48"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="110"/>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="3" Text="Video" Classes="muted small" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="4" Text="Bitrate" Classes="muted small" FontWeight="SemiBold" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="5" Text="Size now" Classes="muted small" FontWeight="SemiBold" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="6" Text="Estimated after" Classes="muted small" FontWeight="SemiBold" HorizontalAlignment="Right"/>
          </Grid>
        </Border>
        <ListBox Classes="rows" ItemsSource="{Binding Rows}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:EncodeRow">
              <!-- The whole row is clickable; Shift-click picks a range (see EncodeView.axaml.cs) -->
              <Border Classes="encrow" Classes.picked="{Binding IsPicked}" Classes.queued="{Binding IsQueued}" PointerPressed="Row_PointerPressed" Cursor="Hand">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="strip"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="150"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding IsPicked}" IsEnabled="{Binding !IsQueued}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                  <Border Grid.Column="1" Background="{DynamicResource Frame}" CornerRadius="3" Padding="4" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                      <Image Classes="shot" Source="{Binding Shot1}" Stretch="UniformToFill"/>
                      <Image Classes="shot" Source="{Binding Shot2}" Stretch="UniformToFill"/>
                      <Image Classes="shot" Source="{Binding Shot3}" Stretch="UniformToFill"/>
                    </StackPanel>
                  </Border>
                  <!-- Play: opens the default player; the button takes the click, so the row isn't picked -->
                  <Button Grid.Column="2" Classes="icon" Command="{Binding PlayCommand}" ToolTip.Tip="Play (opens the default player)" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Path Data="M3,1.5 L3,12.5 L12,7 Z" Fill="{Binding $parent[Button].Foreground}" Width="14" Height="14"/>
                  </Button>
                  <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Folder}" Classes="muted small" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Length}" Classes="muted small"/>
                    <TextBlock Text="{Binding QueueLabel}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" IsVisible="{Binding IsQueued}"/>
                    <!-- Buttons take the click, so they don't pick the row -->
                    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" Margin="0,4,0,0">
                      <Button Classes="small" Content="Exclude folder" Command="{Binding ExcludeFolderCommand}" ToolTip.Tip="{Binding Folder, StringFormat='Hide every video in {0}'}"/>
                      <Button Classes="small" Content="Copy path" Command="{Binding CopyPathCommand}" ToolTip.Tip="Copy the full path"/>
                      <Button Classes="small dangerOutline" Content="Delete" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete this file"/>
                    </WrapPanel>
                  </StackPanel>
                  <TextBlock Grid.Column="4" Text="{Binding Bitrate}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="5" Text="{Binding Size}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Estimate}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding Saving}" FontSize="12" HorizontalAlignment="Right" Classes="muted" Classes.saving="{Binding GoodSaving}"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Border Grid.Row="5" Background="{DynamicResource Sheet}" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="16,12" Margin="-12,12,-12,0" IsVisible="{Binding HasVideos}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="primary" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" IsEnabled="{Binding HasPicked}" FontSize="15" Padding="18,8"/>
        <!-- Per batch: encode here in the queue, or create a script (the default is set in Settings) -->
        <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding RunModes}" SelectedItem="{Binding RunMode}" Margin="0,0,10,0" VerticalAlignment="Center" MinWidth="280">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="core:ChoiceOption"><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding PickedText}" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding PickedSize}" Classes="muted" VerticalAlignment="Bottom"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Toast -->
    <Border Grid.Row="5" IsVisible="{Binding Toast, Converter={x:Static ObjectConverters.IsNotNull}}"
            Background="{DynamicResource Ink}" CornerRadius="4" Padding="14,10" Margin="0,12,0,0"
            HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="680">
      <TextBlock Text="{Binding Toast}" Foreground="{DynamicResource Sheet}" TextWrapping="Wrap"/>
    </Border>

    <!-- Manage hidden folders: each hidden folder with Unhide, a folder to hide (a parent folder too), and Unhide all -->
    <Grid Grid.RowSpan="6" Margin="-12,-16,-12,0" Background="#80000000" IsVisible="{Binding HiddenVisible}">
      <Border Classes="panel" Width="680" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Classes="h2" Text="Hidden folders"/>
            <Button Grid.Column="1" Classes="close" Command="{Binding CloseHiddenCommand}" ToolTip.Tip="Close"><Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6" StrokeLineCap="Round" Width="10" Height="10"/></Button>
          </Grid>
          <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="0,6,0,14"
                     Text="Videos in these folders, and in the folders below them, are left out of this list. They stay hidden after a restart. Scans still read them (to skip a folder in scans, use the paths to skip in Settings)."/>
          <!-- Hide another folder: typed, pasted or chosen -->
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,14">
            <TextBlock Text="Hide a folder" FontWeight="SemiBold"/>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding NewHiddenFolder}" PlaceholderText="A folder, e.g. D:\Videos\Archive - the folders below it are hidden too">
                <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding AddHiddenCommand}"/></TextBox.KeyBindings>
              </TextBox>
              <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseHiddenCommand}"/>
              <Button Grid.Column="2" Classes="primary" Content="Hide" Command="{Binding AddHiddenCommand}"/>
            </Grid>
          </StackPanel>
          <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Classes="primary" Content="Done" Command="{Binding CloseHiddenCommand}"/>
            <Button Content="Unhide all folders" Command="{Binding UnhideAllCommand}" IsEnabled="{Binding HasHiddenFolders}" HorizontalAlignment="Left"/>
          </DockPanel>
          <Border BorderBrush="{DynamicResource Rule}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <Panel>
              <TextBlock Classes="muted" Text="No folders are hidden." Margin="14,12" IsVisible="{Binding !HasHiddenFolders}"/>
              <ScrollViewer Classes="gutter" IsVisible="{Binding HasHiddenFolders}">
                <ItemsControl ItemsSource="{Binding HiddenList}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HiddenFolderRow">
                      <Border BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1" Padding="14,8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Folder}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Videos}" Classes="muted small"/>
                          </StackPanel>
                          <Button Grid.Column="1" Classes="small" Content="Unhide" Command="{Binding UnhideCommand}" VerticalAlignment="Center"
                                  ToolTip.Tip="{Binding Folder, StringFormat='Show the videos in {0} again'}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Panel>
          </Border>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Confirmation before deleting one video -->
    <Grid Grid.RowSpan="6" Margin="-12,-16,-12,0" Background="#80000000" IsVisible="{Binding DeleteVisible}">
      <Border Classes="panel" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Classes="h2" Text="{Binding DeleteTitle}" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Classes="close" Command="{Binding CancelDeleteCommand}" ToolTip.Tip="Cancel"><Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6" StrokeLineCap="Round" Width="10" Height="10"/></Button>
          </Grid>
          <TextBlock Classes="muted" Text="{Binding DeleteText}" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Command="{Binding CancelDeleteCommand}"/>
            <Button Classes="danger" Content="Delete permanently" Command="{Binding ConfirmDeleteCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Confirmation before the script is written -->
    <Grid Grid.RowSpan="6" Margin="-12,-16,-12,0" Background="#80000000" IsVisible="{Binding ConfirmVisible}">
      <Border Classes="panel" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Classes="h2" Text="{Binding ConfirmTitle}" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Classes="close" Command="{Binding CancelCreateCommand}" ToolTip.Tip="Cancel"><Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6" StrokeLineCap="Round" Width="10" Height="10"/></Button>
          </Grid>
          <TextBlock Classes="muted" Text="{Binding ConfirmText}" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Command="{Binding CancelCreateCommand}"/>
            <Button Classes="primary" Content="Create script" Command="{Binding CreateCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
