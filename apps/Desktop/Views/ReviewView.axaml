<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DuplicateVideoRemover.Desktop.ViewModels"
             xmlns:core="using:deepduplicates"
             x:Class="DuplicateVideoRemover.Desktop.Views.ReviewView"
             x:DataType="vm:ReviewViewModel"
             x:Name="Root">
  <UserControl.Styles>
    <!-- The list is for reading and ticking boxes, not for selecting rows -->
    <Style Selector="ListBox.rows ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.video">
      <Setter Property="Background" Value="{DynamicResource Sheet}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Rule}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style Selector="Border.video.selected">
      <Setter Property="Background" Value="{DynamicResource GreaseWash}"/>
    </Style>
    <!-- Every copy of the video is selected for removal: nothing of it will be left.
         The thicker border takes its pixel from the padding, so the card keeps its size. -->
    <Style Selector="Border.video.doomed">
      <Setter Property="Background" Value="{DynamicResource GreaseStrong}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Grease}"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Padding" Value="11,9"/>
    </Style>
    <!-- Hidden but still taking its space: selecting a copy moves the keep mark and the red state between cards, and a card
         that changed height would make the list jump (the clicked card could even scroll out of view) -->
    <Style Selector=":is(Control).unseen">
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style Selector="Button.folder">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="3,0,0,0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <!-- Narrower window: a narrower folder list, then smaller screenshots, so each card keeps room for its text -->
    <Style Selector="DockPanel.folders"><Setter Property="Width" Value="280"/></Style>
    <ContainerQuery Name="review" Query="max-width:1060">
      <Style Selector="DockPanel.folders"><Setter Property="Width" Value="220"/></Style>
    </ContainerQuery>
    <Style Selector="Image.shot"><Setter Property="Width" Value="120"/><Setter Property="Height" Value="80"/></Style>
    <ContainerQuery Name="cards" Query="max-width:760">
      <Style Selector="Image.shot"><Setter Property="Width" Value="96"/><Setter Property="Height" Value="64"/></Style>
    </ContainerQuery>
    <!-- The little copy button next to "Exclude this folder": no bigger than that button -->
    <Style Selector="Button.icon.copy">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    </Style>
    <Style Selector="Button.folder.active">
      <Setter Property="Background" Value="{DynamicResource Sheet}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Heading -->
    <DockPanel Grid.Row="0" Margin="12,16,12,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <Button Content="Compare again" Command="{Binding ReanalyzeCommand}"
                ToolTip.Tip="Uses the saved settings and the videos already read - no files are read"/>
        <Button Classes="primary" Content="Next: re-encode" Command="{Binding GoToEncodeCommand}" ToolTip.Tip="When you are done deleting duplicates"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Classes="h1" Text="Review duplicates"/>
        <TextBlock Classes="muted" Text="{Binding Summary}" Margin="0,4,0,0"/>
      </StackPanel>
    </DockPanel>

    <!-- Nothing to review -->
    <Border Grid.Row="1" Classes="panel" IsVisible="{Binding !HasResults}" Margin="12" VerticalAlignment="Top" Padding="40">
      <StackPanel HorizontalAlignment="Center" Spacing="10">
        <TextBlock Classes="h2" Text="No duplicates to review" HorizontalAlignment="Center"/>
        <TextBlock Classes="muted" Text="Scan your folders to find duplicate and broken videos. Finished results show up here." HorizontalAlignment="Center"/>
        <Button Classes="primary" Content="Go to scan" Command="{Binding GoToScanCommand}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" IsVisible="{Binding HasResults}" Margin="12,0" Container.Name="review" Container.Sizing="Width">
      <!-- Folders -->
      <DockPanel Grid.Column="0" Classes="folders" Margin="0,0,20,0">
        <TextBlock DockPanel.Dock="Top" Classes="h2" Text="Folders" Margin="0,0,0,8"/>
        <ScrollViewer Classes="gutter">
          <ItemsControl ItemsSource="{Binding Folders}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FolderItem">
                <Button Classes="folder" Classes.active="{Binding IsActive}" ToolTip.Tip="{Binding Folder}"
                        Command="{Binding #Root.((vm:ReviewViewModel)DataContext).ShowFolderCommand}" CommandParameter="{Binding Folder}">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Text="{Binding ShortName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding Count}" Classes="muted"/>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SelectedText}" IsVisible="{Binding HasSelected}"
                               Foreground="{DynamicResource Grease}" FontSize="12"/>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <!-- Toolbar, filter and the list -->
      <DockPanel Grid.Column="1">
        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
          <Button Content="Select all duplicates" Command="{Binding SelectAllDuplicatesCommand}" Margin="0,0,8,6"/>
          <Button Content="Select broken and short" Command="{Binding SelectBrokenCommand}" Margin="0,0,8,6"/>
          <Button Content="Select none" Command="{Binding SelectNoneCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,8,6"/>
          <TextBox Text="{Binding Search}" PlaceholderText="Filter by file or folder name" Width="280" Margin="0,0,0,6"/>
        </WrapPanel>
        <Border DockPanel.Dock="Top" Classes="panel" Padding="12,8" Margin="0,0,0,10" IsVisible="{Binding FolderFilterActive}">
          <WrapPanel>
            <TextBlock Text="Showing " VerticalAlignment="Center"/>
            <TextBlock Text="{Binding FolderFilter}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
            <Button Classes="danger" Content="Select all duplicates in this folder" Command="{Binding SelectFolderCommand}" Margin="0,0,8,0"/>
            <Button Content="Unselect folder" Command="{Binding UnselectFolderCommand}" Margin="0,0,8,0"/>
            <Button Content="Exclude folder" Command="{Binding ExcludeFolderCommand}" Margin="0,0,8,0"
                    ToolTip.Tip="Exclude this folder from all matches"/>
            <Button Classes="link" Content="Show all folders" Command="{Binding ShowAllFoldersCommand}" VerticalAlignment="Center"/>
          </WrapPanel>
        </Border>

        <ListBox Classes="rows" ItemsSource="{Binding Rows}" Background="Transparent" SelectionMode="Single" Container.Name="cards" Container.Sizing="Width">
          <ListBox.DataTemplates>
            <DataTemplate DataType="vm:SectionRow">
              <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,18,0,8">
                <TextBlock Classes="h2" Text="{Binding Title}"/>
                <TextBlock Classes="muted" Text="{Binding Subtitle}" VerticalAlignment="Bottom"/>
              </StackPanel>
            </DataTemplate>
            <DataTemplate DataType="vm:GroupHeaderRow">
              <TextBlock Classes="muted small" Text="{Binding Text}" Margin="2,10,0,4"/>
            </DataTemplate>
            <DataTemplate DataType="vm:MoreRow">
              <Button Content="{Binding Text}" Command="{Binding Command}" HorizontalAlignment="Center" Margin="0,12"/>
            </DataTemplate>
            <!-- Between two matched copies: "False positive" takes the copy below out of the group -->
            <DataTemplate DataType="vm:MatchDividerRow">
              <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10" Margin="0,-2,0,4">
                <Border Height="1" Background="{DynamicResource Rule}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Classes="small" Content="False positive" Command="{Binding Command}" ToolTip.Tip="{Binding Tip}" CornerRadius="12"/>
                <Border Grid.Column="2" Height="1" Background="{DynamicResource Rule}" VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate>
            <DataTemplate DataType="vm:VideoRow">
              <Border Classes="video" Classes.selected="{Binding IsSelected}" Classes.doomed="{Binding IsDoomed}">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="14">
                  <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                  <!-- Film strip, crossed out with grease pencil when picked for removal -->
                  <Button Grid.Column="1" Padding="0" Background="Transparent" BorderThickness="0" Command="{Binding ToggleCommand}"
                          ToolTip.Tip="Click to select or unselect">
                    <Grid>
                      <Border Background="{DynamicResource Frame}" CornerRadius="3" Padding="4">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                          <Image Classes="shot" Source="{Binding Shot1}" Stretch="UniformToFill"/>
                          <Image Classes="shot" Source="{Binding Shot2}" Stretch="UniformToFill"/>
                          <Image Classes="shot" Source="{Binding Shot3}" Stretch="UniformToFill"/>
                        </StackPanel>
                      </Border>
                      <Viewbox Stretch="Fill" IsVisible="{Binding IsSelected}" IsHitTestVisible="False">
                        <Canvas Width="100" Height="66">
                          <Path Data="M4,7 Q50,32 96,60 M95,5 Q52,36 5,61" Stroke="{DynamicResource Grease}" StrokeThickness="3" StrokeLineCap="Round"/>
                        </Canvas>
                      </Viewbox>
                    </Grid>
                  </Button>
                  <!-- Play: always in the same place, right of the thumbnails -->
                  <Button Grid.Column="2" Classes="icon" Command="{Binding PlayCommand}" ToolTip.Tip="Play (opens the default player)" VerticalAlignment="Center">
                    <Path Data="M3,1.5 L3,12.5 L12,7 Z" Fill="{Binding $parent[Button].Foreground}" Width="14" Height="14"/>
                  </Button>
                  <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                    <WrapPanel Orientation="Horizontal" ItemSpacing="8">
                      <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                      <!-- Both marks share one place that is always there (in a group), so the name wraps the same way whichever shows -->
                      <Panel IsVisible="{Binding InGroup}" VerticalAlignment="Center">
                        <Border Classes.unseen="{Binding !IsKept}" Background="{DynamicResource KeepWash}" CornerRadius="9" Padding="8,1" HorizontalAlignment="Left">
                          <TextBlock Text="Keep" Foreground="{DynamicResource Keep}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border Classes.unseen="{Binding !IsDoomed}" Background="{DynamicResource Grease}" CornerRadius="9" Padding="8,1" HorizontalAlignment="Left"
                                ToolTip.Tip="Every copy of this video is selected: deleting removes all of them. Unselect one to keep it.">
                          <TextBlock Text="Every copy will be deleted" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                      </Panel>
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="4">
                      <Button Classes="link" Command="{Binding ShowFolderCommand}" ToolTip.Tip="Show only this folder">
                        <TextBlock Text="{Binding Folder}" TextTrimming="CharacterEllipsis"/>
                      </Button>
                      <Button Classes="small" Content="Exclude this folder" Command="{Binding ExcludeFolderCommand}"
                              ToolTip.Tip="Skip this folder in later scans (added to the paths to skip) and take its files out of the matches"/>
                      <Button Classes="icon copy" Command="{Binding CopyFolderCommand}" VerticalAlignment="Center"
                              ToolTip.Tip="{Binding Folder, StringFormat='Copy the folder path to the clipboard: {0}'}">
                        <!-- Two sheets: the copy in front of the original -->
                        <Path Data="M5,1.5 H12.5 V10 M2,4.5 H9.5 V14 H2 Z" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4"
                              StrokeJoin="Round" Width="15" Height="16" Stretch="None"/>
                      </Button>
                    </WrapPanel>
                    <TextBlock Classes="muted small" Text="{Binding Meta}"/>
                    <TextBlock Classes="muted small" Text="{Binding Reason}" IsVisible="{Binding HasReason}" Classes.unseen="{Binding IsKept}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>
      </DockPanel>
    </Grid>

    <!-- Action bar -->
    <Border Grid.Row="2" Background="{DynamicResource Sheet}" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="16,12" IsVisible="{Binding HasResults}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="danger" Content="{Binding ExecuteLabel}"
                Command="{Binding AskExecuteCommand}" IsEnabled="{Binding HasSelection}" FontSize="15" Padding="18,8"/>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Panel>
            <TextBlock Text="{Binding SelectionSize}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Muted}" IsVisible="{Binding !HasSelection}"/>
            <TextBlock Text="{Binding SelectionSize}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Grease}" IsVisible="{Binding HasSelection}"/>
          </Panel>
          <TextBlock Text="{Binding SelectionCount}" Classes="muted" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Toast -->
    <Border Grid.Row="2" IsVisible="{Binding Toast, Converter={x:Static ObjectConverters.IsNotNull}}"
            Background="{DynamicResource Ink}" CornerRadius="4" Padding="14,10" Margin="16,0"
            HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="680">
      <!-- A grid, not a horizontal stack: a long message must wrap inside the toast's width instead of being cut off -->
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="{Binding Toast}" Foreground="{DynamicResource Sheet}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Classes="link" Content="See what failed" Command="{Binding ShowFailuresCommand}" IsVisible="{Binding HasFailures}" Foreground="{DynamicResource Sheet}"/>
      </Grid>
    </Border>

    <!-- Confirmation -->
    <Grid Grid.RowSpan="3" Background="#80000000" IsVisible="{Binding ConfirmVisible}">
      <Border Classes="panel" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="{Binding ConfirmTitle}" TextWrapping="Wrap"/>
          <TextBlock Classes="muted" Text="{Binding ConfirmText}" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Command="{Binding CancelExecuteCommand}"/>
            <Button Classes="danger" Content="Delete permanently" Command="{Binding ExecuteCommand}" IsEnabled="{Binding !Busy}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Progress while deleting -->
    <Grid Grid.RowSpan="3" Background="#80000000" IsVisible="{Binding Busy}">
      <Border Classes="panel" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="Deleting files"/>
          <ProgressBar Value="{Binding DeletePercent}" Maximum="100" Height="14" CornerRadius="7"/>
          <TextBlock Text="{Binding DeleteText}" Classes="muted" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding DeleteFailedText}" Foreground="{DynamicResource Grease}" FontWeight="SemiBold" TextWrapping="Wrap"
                     IsVisible="{Binding DeleteFailedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Files that could not be deleted: file and reason -->
    <Grid Grid.RowSpan="3" Background="#80000000" IsVisible="{Binding FailuresVisible}">
      <Border Classes="panel" Width="760" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="h2" Text="{Binding FailuresTitle}"/>
          <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="0,8,0,12" Text="{Binding FailuresSummary}"/>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,0,0,6">
            <TextBlock Classes="muted small" Text="File" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Classes="muted small" Text="Reason" FontWeight="SemiBold"/>
          </Grid>
          <Button DockPanel.Dock="Bottom" Classes="primary" Content="Close" Command="{Binding CloseFailuresCommand}" HorizontalAlignment="Right" Margin="0,12,0,0"/>
          <ScrollViewer Classes="gutter">
            <ItemsControl ItemsSource="{Binding Failures}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:ExecuteFailure">
                  <Border BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="0,6">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                      <StackPanel>
                        <TextBlock Text="{Binding Entry.FileName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Entry.Folder}" Classes="muted small" TextWrapping="Wrap"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Error}" TextWrapping="Wrap"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
