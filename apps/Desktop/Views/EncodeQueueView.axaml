<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DuplicateVideoRemover.Desktop.ViewModels"
             x:Class="DuplicateVideoRemover.Desktop.Views.EncodeQueueView"
             x:DataType="vm:EncodeQueueViewModel">
  <UserControl.Styles>
    <Style Selector="ListBox.rows ListBoxItem"><Setter Property="Padding" Value="0"/></Style>
    <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Border.qrow"><Setter Property="Background" Value="{DynamicResource Sheet}"/><Setter Property="Padding" Value="12,8"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Rule}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
    <Style Selector="ProgressBar.overall"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Style>
    <Style Selector="ProgressBar.current"><Setter Property="Foreground" Value="{DynamicResource Keep}"/></Style>
    <Style Selector="TextBlock.ok"><Setter Property="Foreground" Value="{DynamicResource Keep}"/></Style>
    <Style Selector="TextBlock.bad"><Setter Property="Foreground" Value="{DynamicResource Grease}"/></Style>
    <Style Selector="TextBlock.skip"><Setter Property="Foreground" Value="{DynamicResource Warn}"/></Style>
    <!-- A delete icon next to a set of pictures: red -->
    <Style Selector="Button.icon.del"><Setter Property="Foreground" Value="{DynamicResource Grease}"/></Style>
    <Style Selector="Button.icon.del:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource GreaseHover}"/><Setter Property="Background" Value="{DynamicResource GreaseWash}"/></Style>
    <!-- Compact view: tight rows and small icon buttons -->
    <Style Selector="Border.qrow.compact"><Setter Property="Padding" Value="12,3"/></Style>
    <Style Selector="Button.icon.tiny"><Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="0"/></Style>
    <!-- A copy that has been deleted: greyed out -->
    <Style Selector="StackPanel.gone"><Setter Property="Opacity" Value="0.35"/></Style>
    <Style Selector="Image.qshot"><Setter Property="Width" Value="96"/><Setter Property="Height" Value="64"/></Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="12,16,12,12">
    <!-- Title and the controls of the run -->
    <DockPanel Grid.Row="0" Margin="0,0,0,14">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <CheckBox Content="Compact view" IsChecked="{Binding Compact}" IsVisible="{Binding !IsEmpty}" VerticalAlignment="Center" Margin="0,0,10,0"
                  ToolTip.Tip="A table without pictures: more videos on the screen"/>
        <Button Classes="primary" Content="Start encoding" Command="{Binding StartCommand}" IsVisible="{Binding CanStart}" FontSize="15" Padding="20,9"/>
        <Button Content="Skip this video" Command="{Binding SkipCurrentCommand}" IsVisible="{Binding HasCurrent}" FontSize="15" Padding="20,9"
                ToolTip.Tip="Gives up on the video being encoded (it is marked as skipped) and goes on with the next"/>
        <Button Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}" FontSize="15" Padding="20,9"
                ToolTip.Tip="Stops encoding. The video being encoded goes back in the queue, and everything keeps waiting until you press Start"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Classes="h1" Text="Re-encode queue"/>
        <TextBlock Classes="muted" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="Videos you add on the Re-encode planning screen wait here and are encoded one at a time. The queue is kept if you close the program."/>
      </StackPanel>
    </DockPanel>

    <!-- Nothing queued yet -->
    <Border Grid.Row="1" Grid.RowSpan="5" Classes="panel" Padding="40" VerticalAlignment="Top" IsVisible="{Binding IsEmpty}">
      <StackPanel HorizontalAlignment="Center" Spacing="10">
        <TextBlock Classes="h2" Text="Nothing in the queue" HorizontalAlignment="Center"/>
        <TextBlock Classes="muted" Text="Pick videos on the Re-encode planning screen and add them to the queue. They are encoded here, with progress." HorizontalAlignment="Center"/>
        <Button Classes="primary" Content="Go to Re-encode planning" Command="{Binding GoToEncodeCommand}" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- The whole queue: where it is, time left, what it saved -->
    <Border Grid.Row="1" Classes="panel" Padding="20,16" Margin="0,0,0,12" IsVisible="{Binding !IsEmpty}">
      <StackPanel Spacing="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Bottom"/>
          <TextBlock Text="{Binding Headline}" Classes="h2" VerticalAlignment="Bottom" TextWrapping="Wrap"/>
        </DockPanel>
        <ProgressBar Classes="overall" Value="{Binding Percent}" Maximum="100" Height="14" CornerRadius="7"/>
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding Left}" Margin="12,0,0,0"/>
          <TextBlock Text="{Binding Totals}" TextWrapping="Wrap"/>
        </DockPanel>
        <WrapPanel>
          <TextBlock Classes="muted" Text="Time so far " />
          <TextBlock Text="{Binding Elapsed}" FontWeight="SemiBold" Margin="0,0,16,0"/>
          <TextBlock Text="{Binding Saved}" Classes="ok" FontWeight="SemiBold" IsVisible="{Binding Saved, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </WrapPanel>
        <Border IsVisible="{Binding HasError}" Background="{DynamicResource GreaseWash}" CornerRadius="6" Padding="12,10" Margin="0,4,0,0">
          <TextBlock Text="{Binding Error}" TextWrapping="Wrap"/>
        </Border>
      </StackPanel>
    </Border>

    <!-- The video being encoded now -->
    <Border Grid.Row="2" Classes="panel" Padding="14,10" Margin="0,0,0,12" IsVisible="{Binding ShowCurrentCompact}">
      <StackPanel Spacing="5" DataContext="{Binding Current}" x:DataType="vm:EncodeQueueRow">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Classes="muted small" VerticalAlignment="Center" Margin="12,0,0,0"><Run Text="{Binding Size}"/><Run Text=", "/><Run Text="{Binding Length}"/><Run Text=" - "/><Run Text="{Binding Summary}"/></TextBlock>
          <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <ProgressBar Classes="current" Value="{Binding Percent}" Maximum="100" Height="10" CornerRadius="5"/>
        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="13"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Classes="panel" Padding="16,14" Margin="0,0,0,12" IsVisible="{Binding ShowCurrentFull}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" DataContext="{Binding Current}" x:DataType="vm:EncodeQueueRow">
        <Border Background="{DynamicResource Frame}" CornerRadius="3" Padding="4" VerticalAlignment="Top">
          <Image Source="{Binding Shot}" Width="168" Height="112" Stretch="UniformToFill"/>
        </Border>
        <StackPanel Grid.Column="1" Spacing="6">
          <TextBlock Text="Encoding now" Classes="muted small"/>
          <TextBlock Text="{Binding FileName}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Folder}" Classes="muted small" TextTrimming="CharacterEllipsis"/>
          <TextBlock Classes="muted small"><Run Text="{Binding Size}"/><Run Text=", "/><Run Text="{Binding Length}"/><Run Text=" - "/><Run Text="{Binding Summary}"/></TextBlock>
          <ProgressBar Classes="current" Value="{Binding Percent}" Maximum="100" Height="12" CornerRadius="6" Margin="0,6,0,0"/>
          <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Waiting and finished videos share the room that is left -->
    <Grid Grid.Row="4" RowSpacing="12" IsVisible="{Binding !IsEmpty}">
      <Grid.RowDefinitions>
        <RowDefinition Height="{Binding WaitingRowHeight}"/>
        <RowDefinition Height="{Binding FinishedRowHeight}"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" BorderBrush="{DynamicResource Rule}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{DynamicResource Table}" Padding="12,6,12,6">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="small" Content="Clear waiting" Command="{Binding ClearWaitingCommand}" IsVisible="{Binding HasWaiting}"
                      ToolTip.Tip="Takes every waiting video out of the queue"/>
              <Button Classes="link" Command="{Binding ToggleWaitingCommand}" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" ToolTip.Tip="Show or hide this list">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Panel Width="14" Height="14" VerticalAlignment="Center">
                    <Path Data="M2,4 L7,10 L12,4 Z" Fill="{Binding $parent[Button].Foreground}" IsVisible="{Binding WaitingExpanded}"/>
                    <Path Data="M4,2 L10,7 L4,12 Z" Fill="{Binding $parent[Button].Foreground}" IsVisible="{Binding !WaitingExpanded}"/>
                  </Panel>
                  <TextBlock Text="{Binding WaitingTitle}" FontWeight="SemiBold"/>
                </StackPanel>
              </Button>
            </DockPanel>
          </Border>
          <TextBlock DockPanel.Dock="Top" Classes="muted" Text="Nothing is waiting. Add more on the Re-encode planning screen." Margin="14,12" IsVisible="{Binding ShowWaitingEmpty}"/>
          <Grid>
          <ListBox Classes="rows" ItemsSource="{Binding Waiting}" Background="Transparent" IsVisible="{Binding ShowWaitingFull}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:EncodeQueueRow">
                <Border Classes="qrow">
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="14">
                    <Border Background="{DynamicResource Frame}" CornerRadius="3" Padding="3" VerticalAlignment="Center">
                      <Image Classes="qshot" Source="{Binding Shot}" Stretch="UniformToFill"/>
                    </Border>
                    <!-- Play: opens the default player, like in the Re-encode planning list -->
                    <Button Grid.Column="1" Classes="icon" Command="{Binding PlayOriginalCommand}" ToolTip.Tip="Play (opens the default player)" VerticalAlignment="Center">
                      <Path Data="M3,1.5 L3,12.5 L12,7 Z" Fill="{Binding $parent[Button].Foreground}" Width="14" Height="14"/>
                    </Button>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Folder}" Classes="muted small" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding Size}" HorizontalAlignment="Right"/>
                      <TextBlock Text="{Binding Length}" Classes="muted small" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Button Grid.Column="4" Classes="small" Content="Remove" Command="{Binding RemoveCommand}" VerticalAlignment="Center"
                            ToolTip.Tip="Take this video out of the queue"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <!-- Compact: a table, no pictures -->
          <DockPanel IsVisible="{Binding ShowWaitingCompact}">
            <Border DockPanel.Dock="Top" Background="{DynamicResource Table}" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,1" Padding="12,3">
              <Grid ColumnDefinitions="2*,3*,70,90,34,84" ColumnSpacing="10">
                <TextBlock Text="Video" Classes="muted small" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="Folder" Classes="muted small" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="Length" Classes="muted small" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="Size" Classes="muted small" FontWeight="SemiBold" HorizontalAlignment="Right"/>
              </Grid>
            </Border>
            <ListBox Classes="rows" ItemsSource="{Binding Waiting}" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:EncodeQueueRow">
                  <Border Classes="qrow compact">
                    <Grid ColumnDefinitions="2*,3*,70,90,34,84" ColumnSpacing="10">
                      <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding OriginalPath}"/>
                      <TextBlock Grid.Column="1" Text="{Binding Folder}" FontSize="12" Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Folder}"/>
                      <TextBlock Grid.Column="2" Text="{Binding Length}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="3" Text="{Binding Size}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                      <Button Grid.Column="4" Classes="icon tiny" Command="{Binding PlayOriginalCommand}" ToolTip.Tip="Play (opens the default player)" VerticalAlignment="Center">
                        <Path Data="M3,1.5 L3,12.5 L12,7 Z" Fill="{Binding $parent[Button].Foreground}" Width="10" Height="10" Stretch="Uniform"/>
                      </Button>
                      <Button Grid.Column="5" Classes="small" Content="Remove" Command="{Binding RemoveCommand}" HorizontalAlignment="Right" ToolTip.Tip="Take this video out of the queue"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          </Grid>
        </DockPanel>
      </Border>

      <Border Grid.Row="1" BorderBrush="{DynamicResource Rule}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{DynamicResource Table}" Padding="12,6,12,6">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="small" Content="Clear finished" Command="{Binding ClearFinishedCommand}" IsVisible="{Binding HasFinished}"
                      ToolTip.Tip="Takes the finished videos out of this list. They can be picked again on the Re-encode planning screen"/>
              <Button Classes="link" Command="{Binding ToggleFinishedCommand}" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" ToolTip.Tip="Show or hide this list">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Panel Width="14" Height="14" VerticalAlignment="Center">
                    <Path Data="M2,4 L7,10 L12,4 Z" Fill="{Binding $parent[Button].Foreground}" IsVisible="{Binding FinishedExpanded}"/>
                    <Path Data="M4,2 L10,7 L4,12 Z" Fill="{Binding $parent[Button].Foreground}" IsVisible="{Binding !FinishedExpanded}"/>
                  </Panel>
                  <TextBlock Text="{Binding FinishedTitle}" FontWeight="SemiBold"/>
                </StackPanel>
              </Button>
            </DockPanel>
          </Border>
          <TextBlock DockPanel.Dock="Top" Classes="muted" Text="Nothing has finished yet." Margin="14,12" IsVisible="{Binding ShowFinishedEmpty}"/>
          <Grid>
          <ListBox Classes="rows" ItemsSource="{Binding Finished}" Background="Transparent" IsVisible="{Binding ShowFinishedFull}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:EncodeQueueRow">
                <Border Classes="qrow">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                      <!-- One picture while there is no check to show (failed or skipped) -->
                      <Border Background="{DynamicResource Frame}" CornerRadius="3" Padding="3" VerticalAlignment="Center" IsVisible="{Binding NoCheck}">
                        <Image Classes="qshot" Source="{Binding Shot2}" Stretch="UniformToFill"/>
                      </Border>
                      <StackPanel Grid.Column="1" Grid.ColumnSpan="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Folder}" Classes="muted small" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="13" Classes.ok="{Binding IsDone}" Classes.bad="{Binding IsProblem}" Classes.skip="{Binding IsSkipped}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4">
                        <TextBlock Text="{Binding WhenText}" Classes="muted small" HorizontalAlignment="Right"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                          <Button Classes="small" Content="Try again" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}"/>
                          <Button Classes="small" Content="Open folder" Command="{Binding ShowFolderCommand}"/>
                        </StackPanel>
                      </StackPanel>
                    </Grid>

                    <!-- The check: the original's pictures from the scan, and the new file's pictures made the same way -->
                    <Grid ColumnDefinitions="*,*,150" ColumnSpacing="16" IsVisible="{Binding HasCheck}">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding OriginalCaption}" Classes="muted small" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="10" Classes.gone="{Binding OriginalDeleted}">
                          <Border Background="{DynamicResource Frame}" CornerRadius="3" Padding="4" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                              <Image Classes="qshot" Source="{Binding Shot1}" Stretch="UniformToFill"/>
                              <Image Classes="qshot" Source="{Binding Shot2}" Stretch="UniformToFill"/>
                              <Image Classes="qshot" Source="{Binding Shot3}" Stretch="UniformToFill"/>
                            </StackPanel>
                          </Border>
                          <!-- Play: opens the default player, like in the Re-encode planning list -->
                          <StackPanel VerticalAlignment="Center" Spacing="6">
                            <Button Classes="icon" Command="{Binding PlayOriginalCommand}" IsVisible="{Binding OriginalAvailable}" ToolTip.Tip="Play the original (opens the default player)">
                              <Path Data="M3,1.5 L3,12.5 L12,7 Z" Fill="{Binding $parent[Button].Foreground}" Width="14" Height="14"/>
                            </Button>
                            <Button Classes="icon del" Command="{Binding AskDeleteOriginalCommand}" IsVisible="{Binding CanDeleteOriginal}"
                                    ToolTip.Tip="Delete the original (to the Recycle Bin, asks first). Only possible because the new file checked out">
                              <Path Data="M6,19 C6,20.1 6.9,21 8,21 L16,21 C17.1,21 18,20.1 18,19 L18,7 L6,7 Z M19,4 L15.5,4 L14.5,3 L9.5,3 L8.5,4 L5,4 L5,6 L19,6 Z" Fill="{Binding $parent[Button].Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                            </Button>
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{Binding NewCaption}" Classes="muted small" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="10" Classes.gone="{Binding NewDeleted}">
                          <Border Background="{DynamicResource Frame}" CornerRadius="3" Padding="4" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                              <Image Classes="qshot" Source="{Binding NewShot1}" Stretch="UniformToFill"/>
                              <Image Classes="qshot" Source="{Binding NewShot2}" Stretch="UniformToFill"/>
                              <Image Classes="qshot" Source="{Binding NewShot3}" Stretch="UniformToFill"/>
                            </StackPanel>
                          </Border>
                          <StackPanel VerticalAlignment="Center" Spacing="6">
                            <Button Classes="icon" Command="{Binding PlayNewCommand}" IsVisible="{Binding NewAvailable}" ToolTip.Tip="Play the new file (opens the default player)">
                              <Path Data="M3,1.5 L3,12.5 L12,7 Z" Fill="{Binding $parent[Button].Foreground}" Width="14" Height="14"/>
                            </Button>
                            <Button Classes="icon del" Command="{Binding AskDeleteNewCommand}" IsVisible="{Binding CanDeleteNew}"
                                    ToolTip.Tip="Delete the new file (to the Recycle Bin, asks first). The original is kept">
                              <Path Data="M6,19 C6,20.1 6.9,21 8,21 L16,21 C17.1,21 18,20.1 18,19 L18,7 L6,7 Z M19,4 L15.5,4 L14.5,3 L9.5,3 L8.5,4 L5,4 L5,6 L19,6 Z" Fill="{Binding $parent[Button].Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                            </Button>
                          </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding CheckText}" TextWrapping="Wrap" FontSize="12" Classes.ok="{Binding CheckOk}" Classes.bad="{Binding CheckFailed}"/>
                      </StackPanel>
                      <!-- What this job saved -->
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2" MinWidth="130" IsVisible="{Binding HasSaving}">
                        <TextBlock Text="{Binding SavingText}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" Classes.ok="{Binding SavingIsGood}"/>
                        <TextBlock Text="{Binding SavingDetail}" Classes="muted" HorizontalAlignment="Right"/>
                      </StackPanel>
                    </Grid>
                    <WrapPanel IsVisible="{Binding CanReplace}">
                      <Button Classes="small dangerOutline" Content="Replace and encode again..." Command="{Binding AskReplaceCommand}" IsVisible="{Binding CanReplace}"
                              ToolTip.Tip="Moves the incomplete new file out of the way and puts the video in the queue again (asks first)"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <!-- Compact: a table, no pictures. The play and delete icons sit in the column of the file they belong to. -->
          <DockPanel IsVisible="{Binding ShowFinishedCompact}">
            <Border DockPanel.Dock="Top" Background="{DynamicResource Table}" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,1" Padding="12,3">
              <Grid ColumnDefinitions="*,120,140,140,110,76" ColumnSpacing="10">
                <TextBlock Text="Video" Classes="muted small" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="Status" Classes="muted small" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="Original" Classes="muted small" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="3" Text="New file" Classes="muted small" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="4" Text="Saved" Classes="muted small" FontWeight="SemiBold"/>
              </Grid>
            </Border>
            <ListBox Classes="rows" ItemsSource="{Binding Finished}" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:EncodeQueueRow">
                  <Border Classes="qrow compact">
                    <Grid ColumnDefinitions="*,120,140,140,110,76" ColumnSpacing="10">
                      <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding OriginalPath}"/>
                      <TextBlock Grid.Column="1" Text="{Binding ShortStatus}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                 Classes.ok="{Binding IsDone}" Classes.bad="{Binding IsProblem}" Classes.skip="{Binding IsSkipped}"
                                 ToolTip.Tip="{Binding StatusText}"/>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Classes.gone="{Binding OriginalDeleted}">
                        <TextBlock Text="{Binding Size}" FontSize="13" Width="58" VerticalAlignment="Center"/>
                        <Button Classes="icon tiny" Command="{Binding PlayOriginalCommand}" IsVisible="{Binding OriginalAvailable}" ToolTip.Tip="Play the original (opens the default player)">
                          <Path Data="M3,1.5 L3,12.5 L12,7 Z" Fill="{Binding $parent[Button].Foreground}" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                        <Button Classes="icon tiny del" Command="{Binding AskDeleteOriginalCommand}" IsVisible="{Binding CanDeleteOriginal}" ToolTip.Tip="Delete the original (to the Recycle Bin, asks first)">
                          <Path Data="M6,19 C6,20.1 6.9,21 8,21 L16,21 C17.1,21 18,20.1 18,19 L18,7 L6,7 Z M19,4 L15.5,4 L14.5,3 L9.5,3 L8.5,4 L5,4 L5,6 L19,6 Z" Fill="{Binding $parent[Button].Foreground}" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                      </StackPanel>
                      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding HasCheck}" Classes.gone="{Binding NewDeleted}">
                        <TextBlock Text="{Binding NewSize}" FontSize="13" Width="58" VerticalAlignment="Center"/>
                        <Button Classes="icon tiny" Command="{Binding PlayNewCommand}" IsVisible="{Binding NewAvailable}" ToolTip.Tip="Play the new file (opens the default player)">
                          <Path Data="M3,1.5 L3,12.5 L12,7 Z" Fill="{Binding $parent[Button].Foreground}" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                        <Button Classes="icon tiny del" Command="{Binding AskDeleteNewCommand}" IsVisible="{Binding CanDeleteNew}" ToolTip.Tip="Delete the new file (to the Recycle Bin, asks first). The original is kept">
                          <Path Data="M6,19 C6,20.1 6.9,21 8,21 L16,21 C17.1,21 18,20.1 18,19 L18,7 L6,7 Z M19,4 L15.5,4 L14.5,3 L9.5,3 L8.5,4 L5,4 L5,6 L19,6 Z" Fill="{Binding $parent[Button].Foreground}" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                      </StackPanel>
                      <TextBlock Grid.Column="4" Text="{Binding SavedShort}" FontSize="13" VerticalAlignment="Center" Classes.ok="{Binding SavingIsGood}"/>
                      <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Classes="icon tiny" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}" ToolTip.Tip="Try again">
                          <Path Data="M17.65,6.35 C16.2,4.9 14.21,4 12,4 C7.58,4 4.01,7.58 4.01,12 C4.01,16.42 7.58,20 12,20 C15.73,20 18.84,17.45 19.73,14 L17.65,14 C16.83,16.33 14.61,18 12,18 C8.69,18 6,15.31 6,12 C6,8.69 8.69,6 12,6 C13.66,6 15.14,6.69 16.22,7.78 L13,11 L20,11 L20,4 Z" Fill="{Binding $parent[Button].Foreground}" Width="13" Height="13" Stretch="Uniform"/>
                        </Button>
                        <Button Classes="icon tiny" Command="{Binding AskReplaceCommand}" IsVisible="{Binding CanReplace}" ToolTip.Tip="Replace the incomplete new file and encode again (asks first)">
                          <Path Data="M17.65,6.35 C16.2,4.9 14.21,4 12,4 C7.58,4 4.01,7.58 4.01,12 C4.01,16.42 7.58,20 12,20 C15.73,20 18.84,17.45 19.73,14 L17.65,14 C16.83,16.33 14.61,18 12,18 C8.69,18 6,15.31 6,12 C6,8.69 8.69,6 12,6 C13.66,6 15.14,6.69 16.22,7.78 L13,11 L20,11 L20,4 Z" Fill="{Binding $parent[Button].Foreground}" Width="13" Height="13" Stretch="Uniform"/>
                        </Button>
                        <Button Classes="icon tiny" Command="{Binding ShowFolderCommand}" ToolTip.Tip="Open the folder">
                          <Path Data="M20,6 L12,6 L10,4 L4,4 C2.9,4 2.01,4.9 2.01,6 L2,18 C2,19.1 2.9,20 4,20 L20,20 C21.1,20 22,19.1 22,18 L22,8 C22,6.9 21.1,6 20,6 Z M20,18 L4,18 L4,8 L20,8 Z" Fill="{Binding $parent[Button].Foreground}" Width="13" Height="13" Stretch="Uniform"/>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>

    <!-- What FFmpeg said -->
    <Grid Grid.Row="5" ColumnDefinitions="*,Auto" Margin="0,10,0,0" IsVisible="{Binding !IsEmpty}">
    <Expander Header="Log">
      <Border Background="{DynamicResource Table}" CornerRadius="4" Padding="10,8" Height="170">
        <ScrollViewer>
          <SelectableTextBlock Text="{Binding Log}" FontFamily="Consolas, Menlo, monospace" FontSize="12" TextWrapping="Wrap"/>
        </ScrollViewer>
      </Border>
    </Expander>
    <!-- Off: deleting needs no confirmation, not even where the file cannot be restored -->
    <CheckBox Grid.Column="1" Content="Confirm before deleting" IsChecked="{Binding ConfirmDeletes}" VerticalAlignment="Top" Margin="12,6,0,0"
              ToolTip.Tip="When this is off, files are deleted at once without asking, also on a network share where they cannot be restored"/>
    </Grid>

    <!-- Toast -->
    <Border Grid.Row="4" Grid.RowSpan="2" IsVisible="{Binding Toast, Converter={x:Static ObjectConverters.IsNotNull}}"
            Background="{DynamicResource Ink}" CornerRadius="4" Padding="14,10" Margin="0,0,0,40"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" MaxWidth="680">
      <TextBlock Text="{Binding Toast}" Foreground="{DynamicResource Sheet}" TextWrapping="Wrap"/>
    </Border>

    <!-- Confirmation before deleting an original or replacing an incomplete new file -->
    <Grid Grid.RowSpan="6" Margin="-12,-16,-12,-12" Background="#80000000" IsVisible="{Binding ConfirmVisible}">
      <Border Classes="panel" Width="580" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="{Binding ConfirmTitle}" TextWrapping="Wrap"/>
          <TextBlock Classes="muted" Text="{Binding ConfirmText}" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Command="{Binding ConfirmNoCommand}"/>
            <Button Classes="danger" Content="{Binding ConfirmButton}" Command="{Binding ConfirmYesCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
